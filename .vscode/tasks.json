{
  // VS Code 里按 ⌘⇧B（或 终端 → 运行任务）→ 选「Dynasty: 导出整合包」即可打包。
  // 任务里显式用 JDK 17（Forge 1.20.1 必须 17），不依赖你机器默认的 JDK 21。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dynasty: 导出整合包（含本体 jar）",
      "type": "shell",
      "command": "./打包整合包.command",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Dynasty: 只构建（不导出）",
      "type": "shell",
      "command": "./gradlew build --offline --console=plain",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Dynasty: 清理挂起的 Gradle 进程",
      "type": "shell",
      "command": "./gradlew --stop; pkill -f 'dynasty/gradle/wrapper' || true; echo '已清理'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
