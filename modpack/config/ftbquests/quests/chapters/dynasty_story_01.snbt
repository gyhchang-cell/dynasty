		{
			id: "1000000000010000"
			title: "01 · 先读这一页 · 路线怎么走"
			subtitle: "主线 · 按连线前进"
			shape: "square"
			size: 1.00d
			x: -8.00d
			y: 0.00d
			icon: { id: "dynasty:dynasty_manual" }
			description: ["&6&l为什么做&r", "不用面对几百个任务猜下一步。先只看『主线旅程』。", "", "&e&l现在怎么做&r", "按编号和连线推进；六边形为永久加槽里程碑。支线/图鉴随时查，不需要收齐。阅读页手动勾选且没有奖励，其余任务按实际行为检测。老玩家已完成节点保留，不必重领。", "", "", "&a&l完成后去哪&r", "下一步：搭起工作台。"]
			disable_jei: false
			tasks: [{ id: "2000000000010000", type: "checkmark" }]
			rewards: []
		},
		{
			id: "1000000000010001"
			title: "02 · 搭起工作台"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -6.50d
			y: 0.00d
			icon: { id: "minecraft:crafting_table" }
			description: ["&6&l为什么做&r", "先拥有 3×3 合成空间。", "", "&e&l现在怎么做&r", "砍树做四块木板，在背包合成格摆成 2×2。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：安置储物箱。"]
			disable_jei: false
			tasks: [{ id: "2000000000010001", type: "item", item: { id: "minecraft:crafting_table", Count: 1b }, count: 1L }]
			rewards: []
			dependencies: ["1000000000010000"]
		},
		{
			id: "1000000000010002"
			title: "03 · 安置储物箱"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -5.00d
			y: 0.00d
			icon: { id: "minecraft:chest" }
			description: ["&6&l为什么做&r", "先把备用材料存好，再出门冒险。", "", "&e&l现在怎么做&r", "八块木板在工作台围成一圈。任务只检测持有；放到据点、记录坐标。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：点亮第一晚。"]
			disable_jei: false
			tasks: [{ id: "2000000000010002", type: "item", item: { id: "minecraft:chest", Count: 1b }, count: 1L }]
			rewards: []
			dependencies: ["1000000000010001"]
		},
		{
			id: "1000000000010003"
			title: "04 · 点亮第一晚"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -3.50d
			y: 0.00d
			icon: { id: "minecraft:torch" }
			description: ["&6&l为什么做&r", "照明和退路比第一把神兵重要。", "", "&e&l现在怎么做&r", "木棍加煤炭或木炭做火把；造一个封闭小屋，条件允许就做床设置重生点。", "", "&a&l掉落与探索&r", "探索宝箱：tiangong_common（留意概率与工具条件）。", "探索宝箱：烽火台（留意概率与工具条件）。", "方块掉落表：music_tier0（留意概率与工具条件）。", "方块掉落表：ruin_reward（留意概率与工具条件）。", "方块掉落表：seal_tier1（留意概率与工具条件）。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：烧炼矿物。"]
			disable_jei: false
			tasks: [{ id: "2000000000010003", type: "item", item: { id: "minecraft:torch", Count: 1b }, count: 8L }]
			rewards: []
			dependencies: ["1000000000010002"]
		},
		{
			id: "1000000000010004"
			title: "05 · 烧炼矿物"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -2.00d
			y: 0.00d
			icon: { id: "minecraft:furnace" }
			description: ["&6&l为什么做&r", "铜锭和铁锭是接下来升级的基础。", "", "&e&l现在怎么做&r", "八块圆石围成一圈做熔炉；用燃料烧炼粗铜、粗铁。先留一把镐的材料。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：先备好采矿工具。"]
			disable_jei: false
			tasks: [{ id: "2000000000010004", type: "item", item: { id: "minecraft:furnace", Count: 1b }, count: 1L }]
			rewards: []
			dependencies: ["1000000000010003"]
		},
		{
			id: "1000000000010020"
			title: "06 · 先备好采矿工具"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -0.50d
			y: 0.00d
			icon: { id: "minecraft:iron_pickaxe" }
			description: ["&6&l为什么做&r", "玉矿和深层龙晶需要合适的镐，先准备再下矿。", "", "&e&l现在怎么做&r", "三块铁锭加两根木棍制作铁镐；采掘时给自己留照明和回程台阶。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：带一桶水出门。"]
