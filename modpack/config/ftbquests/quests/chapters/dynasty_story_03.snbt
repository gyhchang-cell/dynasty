		{
			id: "1000000000000129"
			title: "01 · 科举试卷 ×2"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -6.75d
			y: 0.00d
			icon: { id: "dynasty:exam_paper" }
			description: ["&6&l为什么做&r", "先制作实际用于答题的试卷。", "", "&e&l现在怎么做&r", "获得科举试卷 ×2，放在背包等待检测。", "纸 + 墨囊，一次合成一份。拿在手中右键，选择答案；答对才会完成下一项科举里程碑。", "", "&b&l材料与制作&r", "合成：纸×1 + 墨囊×1 → 科举试卷×1。", "点击本页任务栏里的物品图标，直接打开 JEI 合成界面。多条配方任选一种；也可悬停按 R 看配方、按 U 看用途。标签材料以配方界面为准。", "", "&a&l掉落与探索&r", "方块掉落表：music_tier0（留意概率与工具条件）。", "方块掉落表：music_tier1（留意概率与工具条件）。", "方块掉落表：music_tier2（留意概率与工具条件）。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：&6科举中第。"]
			disable_jei: false
			tasks: [{ id: "2000000000000129", type: "item", item: { id: "dynasty:exam_paper", Count: 1b }, count: 2L }]
			rewards: [{ id: "3000000000012900", type: "item", item: { id: "dynasty:copper_coin", Count: 1b }, count: 10 }, { id: "3000000000012901", type: "xp", value: 6 }, { id: "3000000000012902", type: "command", command: "dynasty merit 12", elevate_perms: true, silent: true }]
			dependencies: ["10000000000a0001"]
		},
		{
			id: "100000000000012a"
			title: "02 · &6科举中第"
			subtitle: "永久 +1 万能饰品槽"
			shape: "hexagon"
			size: 1.00d
			x: -5.25d
			y: 0.00d
			icon: { id: "minecraft:knowledge_book" }
			description: ["&6&l为什么做&r", "答对一次，解锁第一项永久槽位里程碑。", "", "&e&l现在怎么做&r", "手持科举试卷右键答题，至少答对一次。不是仅获得试卷，也不要求先升到天子。", "", "&6&l里程碑奖励&r", "永久 +1 万能饰品槽。原任务与奖励 ID 保留，旧档已领取不会重复增加。", "", "", "&a&l完成后去哪&r", "下一步：虎符。"]
			disable_jei: false
