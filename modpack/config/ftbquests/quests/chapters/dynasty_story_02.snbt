			y: 0.00d
			icon: { id: "minecraft:cobblestone" }
			description: ["&6&l为什么做&r", "先准备导航工具，避免漫无目的找建筑和 Boss。", "", "&e&l现在怎么做&r", "在背包准备四块圆石，完成后点击奖励领取两个原版指南针；再砍四块原木，下一步分别合成两种罗盘。奖励每人仅领取一次，不收走圆石。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：制作两种探险者指南针。"]
			disable_jei: false
			tasks: [{ id: "200000000001000a", type: "item", item: { id: "minecraft:cobblestone", Count: 1b }, count: 4L }]
			rewards: [{ id: "3000000001000a01", type: "item", item: { id: "minecraft:compass", Count: 2b }, team_reward: false }]
			dependencies: ["1000000000010005"]
		},
		{
			id: "100000000001000b"
			title: "02 · 制作两种探险者指南针"
			subtitle: "主线 · 按连线前进"
			shape: "circle"
			size: 1.00d
			x: -8.25d
			y: 0.00d
			icon: { id: "naturescompass:naturescompass" }
			description: ["&6&l为什么做&r", "一件寻找生物群系，一件寻找建筑；两种工具各司其职。", "", "&e&l现在怎么做&r", "先领取上一任务的两个原版指南针。工作台中心放指南针，上下左右放原木，四角留空，合成自然指南针；把原木换成圆石，合成探险者指南针。两件都放在背包即可完成，不收走物品。手持右键打开搜索；自然指南针找群系，探险者指南针找建筑。先进入目标所在维度再搜索。找到群系不等于直接找到 Boss，具体位置与召唤方式查看 Boss 图鉴。", "", "&b&l材料与制作&r", "合成：#minecraft:logs×4 + minecraft:compass×1 → naturescompass:naturescompass×1。", "点击本页任务栏里的物品图标，直接打开 JEI 合成界面。多条配方任选一种；也可悬停按 R 看配方、按 U 看用途。标签材料以配方界面为准。", "&8仅检测物品，不会收走；升级会消耗旧装备，先让该任务完成检测再合成下一件。", "", "", "&a&l完成后去哪&r", "下一步：青铜锭 ×4。"]
			disable_jei: false
			tasks: [{ id: "200000000001000b", type: "item", item: { id: "naturescompass:naturescompass", Count: 1b }, count: 1L }, { id: "200000000001000c", type: "item", item: { id: "explorerscompass:explorerscompass", Count: 1b }, count: 1L }]
			rewards: []
			dependencies: ["100000000001000a"]
		},
