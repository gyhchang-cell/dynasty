+// A top click must remain on the same face from both the interpolated render
+// eye (the cached mouse-over) and the logical eye at input consumption.
+extension TellyPlacement {
+    func sharedTopAim(from poses:[F3Pose], preferredYaw:Double, eyeHeight:Double) -> (yaw:Double,pitch:Double)? {
+        guard axis==1,!poses.isEmpty else{return nil}
+        var yawCandidates=[preferredYaw]
+        for p in poses {
+            for fx in [0.15,0.5,0.85] {for fz in [0.15,0.5,0.85] {
+                yawCandidates.append(atan2(p.x-Double(support.x)-fx,Double(support.z)+fz-p.z)*180 / .pi)
+            }}
+        }
+        var best:(yaw:Double,pitch:Double,score:Double)?
+        for yaw in yawCandidates {
+            let dx = -sin(yaw * .pi/180),dz=cos(yaw * .pi/180)
+            var lo=0.0,hi=88.0,valid=true
+            for p in poses {
+                let height=p.y+eyeHeight-y
+                guard height>0 else {valid=false;break}
+                var entry=0.0,exit=Double.infinity
+                for (origin,direction,lower) in [(p.x,dx,Double(support.x)),(p.z,dz,Double(support.z))] {
+                    let a=lower+0.08,b=lower+0.92
+                    if abs(direction)<1e-9 {if origin<a || origin>b {valid=false;break}}
+                    else {let t0=(a-origin)/direction,t1=(b-origin)/direction;entry=max(entry,min(t0,t1));exit=min(exit,max(t0,t1))}
+                }
+                if !valid || exit<=entry || exit<=0 {valid=false;break}
+                lo=max(lo,atan2(height,exit)*180 / .pi)
+                hi=min(hi,atan2(height,entry)*180 / .pi)
+            }
+            guard valid,hi-lo>0.25 else {continue}
+            let pitch=(lo+hi)/2
+            let rays=poses.map{F3Pose(x:$0.x,y:$0.y,z:$0.z,yaw:yaw,pitch:pitch,time:$0.time)}
+            guard rays.allSatisfy({isVisibleFace(from:$0,eyeHeight:eyeHeight)}) else {continue}
+            let score=abs(F3Pose.angle(yaw-preferredYaw))-min(12,hi-lo)*0.15
+            if best==nil || score<best!.score {best=(yaw,pitch,score)}
+        }
+        return best.map{($0.yaw,$0.pitch)}
+    }
+}
