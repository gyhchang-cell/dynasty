+// A top placement need not wait for a full block of vertical rise once the
+// body has left that column. Small clearance covers the native float width.
+extension TellyPlacement {
+    func clearOfBody(_ poses:[F3Pose]) -> Bool {
+        guard !poses.isEmpty else{return false}
+        return poses.allSatisfy { p in
+            p.x+0.301<=Double(result.x) || p.x-0.301>=Double(result.x+1) ||
+            p.z+0.301<=Double(result.z) || p.z-0.301>=Double(result.z+1) ||
+            p.y>=Double(result.y+1)+0.001 || p.y+1.8<=Double(result.y)
+        }
+    }
+}
