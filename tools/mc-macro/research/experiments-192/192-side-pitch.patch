+// A side face can be visible now but missed when Mouse.next runs after the
+// next position/head update. Keep pitch inside both native ray windows;
+// this does not change the horizontal turn or invent a confirmed block.
+enum SidePitchWindow {
+    static func pitch(target:TellyPlacement,eyes:[F3Pose],eyeHeight:Double,desired:Double)->Double? {
+        guard target.axis != 1,!eyes.isEmpty else{return nil}
+        var lower=0.0,upper=88.0
+        for pose in eyes {
+            let angle=pose.yaw * .pi/180,dx = -sin(angle),dz=cos(angle)
+            let component=target.axis==0 ? dx:dz
+            guard component*Double(target.sign)<(-1e-6) else{return nil}
+            let distance=(target.axis==0 ? target.x-pose.x:target.z-pose.z)/component
+            let other=target.axis==0 ? pose.z+dz*distance:pose.x+dx*distance
+            let edge=Double(target.axis==0 ? target.support.z:target.support.x)
+            guard distance>0,other>edge+0.025,other<edge+0.975 else{return nil}
+            lower=max(lower,atan2(pose.y+eyeHeight-Double(target.support.y)-0.92,distance)*180 / .pi)
+            upper=min(upper,atan2(pose.y+eyeHeight-Double(target.support.y)-0.08,distance)*180 / .pi)
+        }
+        guard upper-lower>0.30 else{return nil}
+        let margin=min(0.5,(upper-lower)*0.2)
+        return max(lower+margin,min(upper-margin,desired))
+    }
+}
