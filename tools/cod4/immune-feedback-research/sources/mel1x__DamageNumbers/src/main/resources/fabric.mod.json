{
  "schemaVersion": 1,
  "id": "damage-numbers",
  "version": "${version}",
  "name": "DamageNumbers",
  "description": "Highly customizable floating damage numbers with presets, custom fonts, animations, gradients, and damage-range styles.",
  "authors": [
    "mel1x"
  ],
  "license": "MIT",
  "icon": "assets/damage-numbers/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.melix.damagenumbers.DamageNumbers"
    ],
    "client": [
      "dev.melix.damagenumbers.client.DamageNumbersClient"
    ],
    "modmenu": [
      "dev.melix.damagenumbers.client.gui.DamageNumbersModMenu"
    ]
  },
  "mixins": [
    "damage-numbers.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_dependency}",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*"
  }
}
