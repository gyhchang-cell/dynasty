  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-BEIJING-YOUAN-OLD",
      "identity": "北京外城南墙偏西右安门，1954年拆除前的历史瓮城",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_3918343"
      ],
      "deduplication": "右安门是南西门同址独立遗存，和内城南侧宣武门、外城中轴永定门及外城东侧左安门分开。后加箭楼与早期未加箭楼图算一个门址。",
      "evidence": [
        {
          "file": "youan-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/750/918.jpg",
          "observation": "1750年图虽有擦损，仍能读出南端弧墙、门轴以及城外独立的水道和跨水线。",
          "sha256": "e2be0d74ae1dfad141992f3df904c8c78d4a54fc60e9ce92a61df7ceea1a881d"
        },
        {
          "file": "youan-axial.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/750/919.jpg",
          "observation": "1920年主门北立面，两道券洞与外部行人在视线上重合，确定不需从侧闸进入。",
          "sha256": "9e9412534589220a7bbd2c8ca2d59571afc5cecb79189bc40b5931c46760e4df"
        },
        {
          "file": "youan-moat.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/750/926.jpg",
          "observation": "1922年沿壕拍摄，低土质岸坡、墙根小屋与外端箭楼构成上下层次。",
          "sha256": "74d30a36433ebcff1cd8e0eb94cd6d4fe12773b6f916b30a923402be629d3166"
        },
        {
          "file": "youan-south.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/750/930.jpg",
          "observation": "1922年西南面，箭窗两层，砖台、瓦楼以及城外低屋的尺度清楚。",
          "sha256": "5a3c831624142d3a7114dd0ef76a3b1ba311fadabd168e5dc82cafcbb0e93d16"
        }
      ],
      "layout": "外城南垣附着弧墙，外箭楼中券对准北侧的主门。南面先渡护城河再通过双门。",
      "proportion": "两座单层门楼与较厚城台构成上下两段，和内城多檐高楼以及附近棚屋形成不同尺度。",
      "facade": "主门回廊通透且被树木部分遮掩，箭楼砖面规整排布小窗。",
      "roof": "低楼灰筒瓦。史料说明使用小型斗拱、无琉璃，黑白照片保留实际屋面和檐口轮廓。",
      "material": "筒瓦、砖券洞和外墙、木构门廊，壕边以缓斜土岸过渡。",
      "circulation": "两道孔门直通，中间宽缓；出门之后才经石桥进入田地与城外村舍。",
      "terrain": "西南岸地势平缓，护城河压低于门前步道；树荫和散布小屋令近墙处尺度渐变。"
    },
    {
      "id": "BOSS02-FORT-CN-BEIJING-CHONGWEN-OLD",
      "identity": "北京内城南墙东侧崇文门，1900年箭楼损毁和侧闸改建之前完整形态",
      "sources": [
        "https://k.sina.cn/article_6995117795_p1a0f106e300100vbho.html",
        "https://www.sohu.com/a/233656067_99925789",
        "https://xinwen.bjd.com.cn/content/s62e8d730e4b0f80526933446.html"
      ],
      "deduplication": "哈德门、海岱门按同一节点合并。与同南墙的正阳、宣武不同。1900年之后箭楼损毁、铁路打穿院墙的形态仅用作分期，不另计。",
      "evidence": [
        {
          "file": "chongwen-map.jpg",
          "source": "https://k.sinaimg.cn/n/sinakd10112/680/w440h240/20200508/df5f-iteyfww4092290.jpg/w700d1q75cms.jpg",
          "observation": "乾隆京城图节选显主楼位居北墙，西北角庙与西侧闸楼在同一带，图像下缘裁去部分南墙。",
          "sha256": "35d70fa5e269a977465261ddbd1640a589ba4e5db25fc800ba1d67206a145074"
        },
        {
          "file": "chongwen-whole.jpg",
          "source": "https://k.sinaimg.cn/n/sinakd10112/656/w440h216/20200508/eb45-iteyfww4092466.jpg/w700d1q75cms.jpg",
          "observation": "1870年代西向东，城楼、居中的较低侧闸和外箭楼被同一长垛墙串联。",
          "sha256": "17026b3f7814e172e2f1fd81a0e9e07c4c1eec2c59447670c39acb2d9ca0a72a"
        },
        {
          "file": "chongwen-court-1898.jpg",
          "source": "https://k.sinaimg.cn/n/sinakd10112/728/w440h288/20200508/d7cf-iteyfww4092553.jpg/w700d1q75cms.jpg",
          "observation": "1898年院内，主楼下门洞与西北角低庙、围栏和院内活动用地可辨。",
          "sha256": "69aab1b56798b1b3d3522be234c3d08928d30c075e20819667ac44a5b0364745"
        },
        {
          "file": "chongwen-reworked-court.jpg",
          "source": "https://static.bjd.com.cn/dams-res/editing/image/202312/31/65911c3fd5de9bf2816c6dd4.jpeg",
          "observation": "1905年主楼与敞院可互证，前景横向铁路属于破坏原流线以后，不用于旧西闸复原。",
          "sha256": "c282c84d1dca29c21859b4150975851a2e1a9984cbe3ba4f4681e607f2e5d05e"
        }
      ],
      "layout": "近平面矩形，北两角接直长城垣，南角抹圆，箭楼居南，西月墙原设独立低闸，院西北可置小庙。",
      "proportion": "图文记院78米宽、86米深。照片中的成排院内矮屋与门楼比例形成清楚的空间层级。",
      "facade": "主楼木廊和砖台、外箭楼排窗、西闸的较低檐口，在全景里均可独立识别。",
      "roof": "主楼三滴水重檐歇山，箭楼重檐，西闸单檐，低庙与附屋并未覆盖主院。",
      "material": "图像可辨砖台、券洞和瓦檐，配色据文字记录，不用后期调色图推断。",
      "circulation": "跨壕后在城外转往西侧闸，院内再转向北城门。后来南通口和东西铁路券洞须按改建时期单看。",
      "terrain": "壕沟低于月墙根，城台高于院内地坪，并有沿河接主路的外场空间。"
    }
  ],
