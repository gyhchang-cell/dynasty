    {
      "id": "BOSS02-FORT-CN-XINGCHENG-WEIYUAN",
      "identity": "辽宁兴城（宁远）北门威远门及半圆外瓮城",
      "sources": [
        "https://whly.ln.gov.cn/whly/wlzt/lnww/zdwwbhdw/3319551CD2874AB88A55B327EB73BAA2/",
        "https://m.sohu.com/a/112766599_217906",
        "https://wlj.nanjing.gov.cn/ztzl/mcq/syjj/201710/t20171026_794970.html"
      ],
      "evidence": [
        {
          "file": "weiyuan-court.jpg",
          "source": "https://img.mp.sohu.com/q_70%2Cc_zoom%2Cw_640/upload/20160830/988c5f0f69644c31a8d0d22ba4026b2b_th.jpg",
          "sha256": "defd412cccce3737552488dd305ecaaaba07cbff35b25e865bde90107cc80713",
          "photographer": "黄华",
          "observation": "院内同一角度见左侧外门、右侧主城门和中间的弧墙、主墙相接。"
        },
        {
          "file": "weiyuan-route.jpg",
          "source": "https://img.mp.sohu.com/q_70%2Cc_zoom%2Cw_640/upload/20160830/d762190305e348398b4673a422c25520_th.jpg",
          "sha256": "9b4e86c800fdab9771aaf87b155e9816dd78489e96bd10c0fba2c963bc07b0bc",
          "photographer": "黄华",
          "observation": "券洞内看外部铺路与围墙，门洞由连续拱券收束。"
        }
      ],
      "deduplication": "兴城、宁远为同一地点的名称，北门及外瓮城一例。门洞、楼阁、半圆墙、照片角度不拆分。与已核十三处按地点及城门属性去重。",
      "layout": "半圆外墙附在相对直的主城墙。现场照片同幅验证两门与中间连续墙面，外门在弧边，主门穿过有城楼的墙段。",
      "proportion": "院地较开敞，券门尺度明显小于墙宽，外墙不另置同等级的高楼。未取照片透视尺寸。",
      "facade": "主城墙垛口更高，券门砖拱与弧墙阴影显出墙厚；高门楼与弧墙长面有清楚主次。",
      "roof": "主门上的高楼可见重檐与挑角，院面完全朝天。弧墙门口照片未见覆盖整个院落的屋面。",
      "material": "近景可见墙身水平砖行、券顶放射状砖缝与硬铺地面。墙芯、年代和修复砖比例不从照片推断。",
      "circulation": "由城外小路穿连续拱券抵瓮城，再转至主门接北街。省文旅厅记瓮城门采用内外两重联券，现场影像支持纵深。没有核实历史登城起点。",
      "terrain": "现场外侧接近路有弯曲，院面当前硬铺。主城放在规整卫城边界内，未将其它城门的护城河或历史桥位套入此例。",
      "transfer": "可比较连续两道拱券形成的进门阴影与转入露天院心的空间节奏。"
    }
  ],
