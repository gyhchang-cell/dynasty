  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-JINGTAI-YONGTAI-SOUTH",
      "identity": "甘肃景泰永泰城南门，永宁外门、永泰内门及2019年实拍南瓮城",
      "sources": [
        "https://www.jingtai.gov.cn/zfxxgk/bmhxzxxgk/xzjdzfml/hsz/fdzdgknr/whly/art/2023/art_0e8726f2ea1b446999715e8b19503a1d.html",
        "https://www.jingtai.gov.cn/zfxxgk/bmhxzxxgk/xzjdzfml/stx/fdzdgknr/sthj/art/2026/art_003c9897cf26467099833498d99dd117.html",
        "https://www.thepaper.cn/newsDetail_forward_21876159",
        "https://www.xinhuanet.com/english/africa/2019-05/29/c_138098174.htm"
      ],
      "deduplication": "景泰县寺滩乡永泰村唯一有连续内外门的南门组。东、西、北封闭月城为同堡附属构件。与山西大同永泰门、西安永宁门均不同址。",
      "evidence": [
        {
          "file": "yongtai-south-detail.jpg",
          "source": "https://imagepphcloud.thepaper.cn/pph/image/237/893/670.jpg",
          "sha256": "e5c6922fe9e8f4ec7461168502dd7c2842a2372c0199c7e86e6ae8b2f90622e2",
          "observation": "新华社马宁，2019。见两道砖拱、夯土曲墙两端搭回主垣、院内道路与外门上的小屋。"
        },
        {
          "file": "yongtai-xinhua.jpg",
          "source": "https://www.xinhuanet.com/english/africa/2019-05/29/138098174_15590861838091n.jpg",
          "sha256": "b4931116947514054187cb214ebb1b7740a4a4a1cf4f485b88a2a4b29744dfb6",
          "observation": "同组航拍远照明示门组是主垣向南突出的入口，能区分另外三座封闭月城和城外空旷地貌。"
        }
      ],
      "layout": "较圆的半环向南挑出，在两处转角接回主城墙。外券占据弧前近中部位置，内券从长墙开出，院内露天。",
      "proportion": "贴地的墙基出挑宽于墙顶，内外两券只各占相应立面小段。外券上小屋形成尺度参照。",
      "facade": "平缓夯土弧墙有面层风化和不同高度，券洞轮廓另用较规则的石砖饰面勾勒。",
      "roof": "2019图中外券上可见一座低小瓦屋；内券所在主城墙顶部敞开。本条只记图中现状，不把历史药祖阁复原入图。",
      "material": "主围墙是黄土夹砂夯筑，拱券为砖石构造，院地及外围以土石质感为主。",
      "circulation": "外路经南侧外券进入浅弧形明院，近对准内券，内路连续接村中主巷。",
      "terrain": "戈壁高原的开阔地面围绕建筑，外环人工沟带和车路在独立的更外一圈。"
    },
    {
      "id": "BOSS02-FORT-CN-JUYONGGUAN-NORTH-RESTORED",
      "identity": "北京昌平居庸关北关城门、矩形瓮城及恢复后的院内真武庙门组",
      "sources": [
        "https://www.beijing.gov.cn/renwen/rwzyd/lyjq/4A/jygcc/202210/t20221018_2838580.html",
        "https://www.visitbeijing.com.cn/article/47QrHjfJu7y",
        "https://lyzz.visitbeijing.com.cn/news/detail?id=24975",
        "https://commons.wikimedia.org/wiki/File:Juyongguanfromnorth.jpg"
      ],
      "deduplication": "按昌平居庸关关沟北端的复原北关城门计一例。南口的马蹄形瓮城已计并另处，八达岭关城也不是这处北门。",
      "evidence": [
        {
          "file": "juyong-north-candidate.jpg",
          "source": "https://upload.wikimedia.org/wikipedia/commons/a/a0/Juyongguanfromnorth.jpg",
          "sha256": "ddeeb59ffbf9d73eeb3fe1e1907fcf9c4b3a3afccb7e673b7b8b37563851d0bd",
          "observation": "Charlie fong 从北侧眺望的原始全景。图中前景红绿城楼与矩形院为北关，主券、院壁转角、地面旁路、院中祠庙和向两山续接的主垣同在。远处另一居庸关楼不并入。",
          "author": "Charlie fong",
          "license": "CC BY-SA 4.0",
          "file_page": "https://commons.wikimedia.org/wiki/File:Juyongguanfromnorth.jpg"
        }
      ],
      "layout": "走向接近关沟的近矩形外院向北突出，两条侧墙回接横跨关沟的主墙。真武庙位于院内一边。",
      "proportion": "前院进深较长，主楼横宽小于两翼山墙跨度，院内小屋形成次一级体量。",
      "facade": "主城楼下见中心拱券，两翼城垣循山势抬升；前围墙低于楼顶线。",
      "roof": "主楼红身配绿瓦二层檐口，院内小屋深瓦或暖瓦；围墙壳体为露天。",
      "material": "浅青灰砖石城台及墙体、红色栏廊和深绿瓦屋与谷中植被共构现状色带。",
      "circulation": "地方旅游部门记录北向外门；从北外门进有真武庙的前院，再穿主券进入关沟纵向主路。现代公路绕院外走。",
      "terrain": "关沟狭长，院两翼靠陡坡。主城墙向两处山脊续接，谷底交通和墙顶步道分层。",
      "source_conflict": "市级景区介绍的概述段落泛称南北券城半圆；同站专项写北瓮城长方。条目按北侧全景能确认的现状矩形轮廓，历史轮廓待修缮测图。"
    }
  ],
