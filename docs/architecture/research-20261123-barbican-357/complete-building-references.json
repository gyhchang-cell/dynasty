  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-DATONG-YONGTAI-RESTORED",
      "identity": "大同古城永泰门复建南门组",
      "sources": [
        "https://www.sohu.com/a/314074938_120047347",
        "https://blog.sina.com.cn/s/blog_8804137b0102zban.html",
        "https://www.dt.gov.cn/dtszf/tzbh/202501/90fdf675866543ac992ab6165c1b60d0/files/2d8e11c520504dd798f96517c3103a9a.pdf"
      ],
      "deduplication": "大同南向多重城防为一例。和阳门为东侧，清远门为西侧，两者均已收录。耳城、关城、各楼、施工前后和夜景不重复计。研究现状复建，未据此确定明代南门实际边界。",
      "evidence": [
        {
          "file": "yongtai-aerial.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20190515/88a3213ccb9c4110bd889aa152910603.jpeg",
          "sha256": "9e492672baefae5a0dde743f9bca2ed81ac95eaeadc3d1a09c18388f38261b6e",
          "observation": "从主城侧俯视，主门在近处，嵌套的方瓮城与外月城向外接中央关城及对称耳城；外围水面与两侧跨水路清楚。"
        },
        {
          "file": "yongtai-tower.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20190515/bcc69cae19ab41b0a350143752759a45.jpeg",
          "sha256": "282bb3a77d0f2b90e48e85e48224aea530131a77884540484fd14a44a5781a4b",
          "observation": "永泰门门额、主券、高砖墙、三层瓦檐及木柱齐全。"
        },
        {
          "file": "yongtai-view.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20190515/a205e7dccfad42d5bdc336292af11739.jpeg",
          "sha256": "52d1a91efb5e52538fe86f8a31fd2f129b3346e7e777a6684edaae56cc60a36d",
          "observation": "从地面看主楼及深券洞。现场临时红毯与棚列只证明院内可容纳队列，未计入建筑。"
        }
      ],
      "layout": "内圈矩形围院依附长城墙，外月城外围继续接中央收放的关城，两翼小院和内圈形态明确区分。",
      "proportion": "主门为最高最宽的视觉终点，月城和耳城的墙和楼逐级变低。对称翼院小于中心入城院。用俯拍读相对大小，不从图片反推米数。",
      "facade": "厚砖城台开深券，三层檐口上置匾额，木质开敞廊与浅灰砖墙作对比。",
      "roof": "主楼和次楼通过层数与檐宽分级，主院和翼院全敞开。",
      "material": "灰砖包墙、石质券脚与铺面、红色木廊及瓦屋面能直接辨认。",
      "circulation": "中心线串联多道地面门限，最内圈仍见侧开口，耳城独立联通，不能按同视线贯穿每道门处理。",
      "terrain": "外沟在围院平场下，近岸草植和横桥把宽水边拆成独立区段。适合研究水岸、复合院墙和入口前场一起出现时的比例。"
    },
    {
      "id": "BOSS02-FORT-CN-PINGYAO-GONGJI",
      "identity": "平遥古城北门拱极门和偏开外门的窄瓮城现状",
      "sources": [
        "https://gs.ctrip.com/html5/you/travels/365/4110615.html",
        "https://www.cgejournal.com/cn/article/pdf/preview/8358.pdf"
      ],
      "deduplication": "用北门节点和东向外口定位，与本台账平遥南门迎薰门不同。城楼、外口、围墙、护城沟只组成一个案例，不按修复时期拆开计数。",
      "evidence": [
        {
          "file": "gongji-1.jpg",
          "source": "https://dimg04.c-ctrip.com/images/1mf3l12000c0gizpmD06C_W_640_0_Q90.jpg?proc=autoorient",
          "sha256": "2802c4b438da50f965dac494c294aa8e231c224b3c06e334bc3db7dc9d53f527",
          "observation": "外侧视角见北门楼、正交院墙、斜收墙脚与小券口。前景是低于院墙的沟侧空间。"
        },
        {
          "file": "gongji-2.jpg",
          "source": "https://dimg04.c-ctrip.com/images/1mf4g12000c0giv7d71C8_W_640_0_Q90.jpg?proc=autoorient",
          "sha256": "157fa05681a324f4edce5fa688926d426ef2fe5457bec10896e2a540b54622ac",
          "observation": "院内仰视可见厚砖主券、右侧石阶和楼台木廊，院墙紧接在旁。"
        },
        {
          "file": "gongji-3.jpg",
          "source": "https://dimg04.c-ctrip.com/images/1mf5h12000c0giwcwCDB7_W_640_0_Q90.jpg?proc=autoorient",
          "sha256": "167c30cd5e18a0e426c6de4cf8782d2363f67018a6edfcd7616d39f0467e3f49",
          "observation": "另一面主楼、开敞木层、主券及街侧铺装和绿带。"
        }
      ],
      "layout": "北门以近方形瓮城接长北墙；进东向外门再折向主门。院窄而墙高。",
      "proportion": "主楼五间、进深四间见图文说明。院内主券明显高于近底平台，墙和楼台将入口比例分开。",
      "facade": "外墙垛口与券门低位开口形成强主次，高位木廊保留可见空间，主券与石台清楚。",
      "roof": "门楼高位重檐瓦顶，旁侧庭院露天，深檐勾出主楼轮廓。",
      "material": "砖墙、浅石基、券砖、木构和彩饰瓦檐可辨，不凭单张照片判断历年换砖比例。",
      "circulation": "城东朝向的外口使行人转向，再经主券入城，院内靠墙楼梯与地面直走段分工。",
      "terrain": "院墙外收脚与沟边铺地高差明显，实拍时看不出历史水深或原吊桥样式。"
    }
  ],
