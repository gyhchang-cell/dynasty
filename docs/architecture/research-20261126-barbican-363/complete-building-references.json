        },
        {
          "file": "tainan-inside.jpg",
          "source": "https://upload.wikimedia.org/wikipedia/commons/f/f2/%E5%8F%B0%E7%81%A3%E5%BA%9C%E5%9F%8E_%E5%8D%97%E9%96%80_%E7%94%95%E5%9F%8E_Tainan_South_Gate_-_panoramio.jpg",
          "sha256": "564300822327a9311f731dee28a30cd011fe8d15784ea55358b09ed98566c754",
