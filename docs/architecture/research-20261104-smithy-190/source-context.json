      "original_text": "modLoader=\"javafml\"\nloaderVersion=\"[40,)\"\nlicense=\"MIT\"\n\n[[mods]]\nmodId=\"simply_houses\"\nversion=\"1.1.4-1.20.1\"\ndisplayName=\"Simply Houses\"\nlogoFile=\"logo.png\"\nauthors=\"Aurelj, DiamondTown & Zephyrusj\"\ndescription='''\nSimply Houses is a mod that generates a bunch of simple structures, meant to provide early-game accomodation or as a way to enhance your worlds. These structures are mostly passive and often include useful loot.\n'''\n\n[[dependencies.simply_houses]] #optional\n    modId=\"forge\"\n    mandatory=true\n    versionRange=\"[46,)\"\n    ordering=\"NONE\"\n    side=\"SERVER\"\n\n[[dependencies.simply_houses]]\n    modId=\"minecraft\"\n    mandatory=true\n    versionRange=\"[1.20,)\"\n    ordering=\"NONE\"\n    side=\"SERVER\"\n"
