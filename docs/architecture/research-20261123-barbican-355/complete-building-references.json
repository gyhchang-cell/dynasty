  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-BEIJING-ZUOAN-OLD",
      "identity": "历史左安门，外城南垣东门及弧形瓮城",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_3857756",
        "https://www.visitbeijing.com.cn/article/47mtiaCzWyI"
      ],
      "deduplication": "江擦门、礓礤门同指此门址，与外城南垣西段右安门分开。值房、邻近东南角楼、墙面和先后影像不额外计数。",
      "evidence": [
        {
          "file": "zuoan-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/130/991.jpg",
          "observation": "1750年平面上，北半与直城墙相接；外墙弧形，门口与城外跨壕桥保持轴向。早期地图时点尚未加外箭楼。",
          "sha256": "f0d8672268fbfc4bc83ef5ddf2d35d4c96f08f7205b80d9a126f54b1c1a9aba5"
        },
        {
          "file": "zuoan-main.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/130/999.jpg",
          "observation": "1920年前后主楼侧后方，单檐和回廊、残存马道及附房可辨，残损段不当作当时可走路线。",
          "sha256": "bb0a64e636991d2d87d3aed32d3c9a5f26e12503e4ae95382acb2028f4756342"
        },
        {
          "file": "zuoan-inside.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/131/1.jpg",
          "observation": "1920年前后从主门券内往南，瓮城两侧有低棚，仍可看到外箭楼下的南向券口。",
          "sha256": "f6133f8f22ad3f3a779087667726eaf1091283453171a9a6a284a7c4bad34156"
        },
        {
          "file": "zuoan-outer.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/131/13.jpg",
          "observation": "南面外箭楼画像中两排箭窗和内外门洞的对正可辨，旧照有后期上色，颜色不用作依据。",
          "sha256": "f625c47bf0b5d6ed0fb678cb34924578bf28bf46f8e795b093748023184da379"
        },
        {
          "file": "zuoan-east.jpg",
          "source": "https://imagenfs.thepaper.cn/image/24/131/12.jpg",
          "observation": "外箭楼与东段墙连为一体，低水位下仍呈连续壕岸与墙外土台。",
          "sha256": "70f2c60d47bdda4c32b5aee055a6fb2f49461165d6be6921717964067b74f64c"
        }
      ],
      "layout": "外郭墙内端为单层门楼，外端箭楼占据弧墙正中，瓮城是带直侧墙和弧形外缘的紧凑敞院。",
      "proportion": "资料记瓮城东西约23米、南北约29米。门洞和低棚可用作车马与建筑之间的比例参照。",
      "facade": "外箭楼以两排箭窗和厚砖台为主，内门上层形成开敞木廊，两道券洞方向一致。",
      "roof": "两座小式单檐歇山，粗略高度接近，庑廊与窄棚退到过门路线两侧。",
      "material": "照片见砖券、夯土残石和木柱，文字记录主楼为灰筒瓦、不施琉璃。",
      "circulation": "由外壕桥入南券，再穿短院至北主门；城墙马道独立于过门轴。",
      "terrain": "地势缓，城外近水而内侧有开阔田地；壕沟沿月墙弧线绕行，岸侧未贴楼墙直切。"
    },
    {
      "id": "BOSS02-FORT-CN-BEIJING-GUANGAN-OLD",
      "identity": "历史广安门，外城西垣广宁门乾隆改建后至拆瓮城前的构成",
      "sources": [
        "https://beijingofdreams.com/dongbian.html",
        "https://xinwen.bjd.com.cn/content/s5f4cc2c4e4b09caabb2d264b.html",
        "https://wwj.beijing.gov.cn/bjww/362760/362767/bjzzxwhycccycxds/dsxw/11156748/"
      ],
      "deduplication": "广宁门、民间彰义门同址合并。与外城东广渠门、北肩西便门、内城阜成门区分；三张喜仁龙图看同一门组。",
      "evidence": [
        {
          "file": "guangan-whole.jpg",
          "source": "https://beijingofdreams.com/images/fixed/zhangyi_men/peking.gates.160.a.jpg",
          "observation": "侧景看见高的三层瓦檐主楼、低箭楼和整段连接砖垛墙，近处地势低陷。",
          "sha256": "4c43afb267561ca2edece9d52484cb4cbbce0ad8d1e0b45b5aaf048778c3d491"
        },
        {
          "file": "guangan-court.jpg",
          "source": "https://beijingofdreams.com/images/fixed/zhangyi_men/peking.gates.163.a.jpg",
          "observation": "从外楼一侧看院和主楼，路两旁摊屋留出大截净宽，主门有上层开放木廊。",
          "sha256": "cb9fb45b5e5ac4712ac936e312c3a028e2b544fc6e88e0d35284574a017860f7"
        },
        {
          "file": "guangan-exterior.jpg",
          "source": "https://beijingofdreams.com/images/fixed/zhangyi_men/peking.gates.164.a.jpg",
          "observation": "外端正中穿箭楼砖券，可在门洞中看见另一券口；骆驼沿一侧进入，体现直线通行尺度。",
          "sha256": "12df3082a6fdfbfda7e691ad17e71fe8d592370bb54a788ae947f92702be7310"
        }
      ],
      "layout": "门组凸出外城西垣，近方形院子的两外角收圆，两道门沿西东轴对开。",
      "proportion": "史料记院深34米、宽39米，主楼连台约26米，箭楼连台约16.6米；比左安门的两座低楼高差明显。",
      "facade": "主楼重廊敞面，外箭楼瓦坡下是两排逐格箭窗，高而宽的砖券洞将内外两条路贯通。",
      "roof": "主楼是三滴水重檐歇山，外箭楼单檐歇山。低屋在敞院两边，不盖过交通线。",
      "material": "墙身与券口为砌体，主楼木柱、瓦面与说明所载灰筒瓦、绿剪边相符；具体色差不据黑白照判断。",
      "circulation": "外券进入短院并直抵高主楼券洞，散开的摊铺和候行队伍留在边线。旧官道向西通宛平一带。",
      "terrain": "外侧土坡、壕沟前场与高墙分层，院内用近水平铺地照顾运输；照片不能用来定桥高或水位。"
    }
  ],
