      "evidence": [
        {
          "file": "chongwu-north.jpg",
          "source": "https://commons.wikimedia.org/wiki/File:Hui%27an_Chongwu_Cheng_20120302-20.jpg",
          "author": "Zhangzhugang",
          "license": "https://creativecommons.org/licenses/by-sa/4.0/",
