          "sha256": "b6f675e599f96a2383cbdd6d0f61ce7f2ef2b3cfe8ff1513dd36a77e7bf143da"
        }
      ],
      "actually_viewed": "从墙顶俯看的完整小院，照片同框见两道门、连接墙角、屋顶与外侧垛墙。现场调查印刷页111说明同类月城通道及墙体做法，表18北门单列。",
      "deduplication": "以北部节点计一例。上批东月城可在图像和地理位置上独立辨认，本批北门照片为下沉小院及相邻墙面门位，并非东门外立面的另一角度剪裁。西部与南部不计。",
      "layout": "调查记北门外附弧墙。俯视中可见前景院边弯转、两券分别落在相邻墙面，小院紧贴主门墙。",
      "proportion": "院底相对墙顶下沉明显，侧门门口窄于主券。调查为同类月城给的数据不应用作北门独立精确测量。",
      "facade": "主券用大石块勾轮廓，侧口处墙台与门洞分层。顶缘可见垛墙、宽走面和转角。",
      "roof": "主门上方为可见坡瓦顶，小院和墙顶带露天。现场角度限于门楼一面，不推测完整屋架。",
      "materials": "照片可辨条石券口与粗细不同的石块，调查描述花岗石砌面和夯土内芯。",
      "circulation": "由一侧孔道入开敞小院，再折入主门。俯视照片同时提供上、下两条空间带，高位起点和登城梯段没有核实。",
      "terrain": "石铺院底、外侧平台和坡变墙脚分别可见。照片不能确定历史地坪或周围排水断面。",
      "transfer": "可比较自然曲线与高低两层行走面如何在小院相接。"
    }
  ],
