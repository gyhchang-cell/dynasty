    {
      "id": "BOSS02-FORT-CN-BEIJING-ANDING-OLD",
      "identity": "北京安定门拆除前的完整瓮城建筑群",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_2779577",
        "https://www.museum.bj.cn/zlxx/content/2010-12/05/content_21747.htm"
      ],
      "evidence": [
        {
          "file": "anding-1860.jpg",
          "source": "https://imagenfs.thepaper.cn/image/13/547/242.jpg",
          "sha256": "62cc0070db696b4919b15a176cea50630d207253613c4b5bf696909e81a500b6",
          "observation": "1860年东北侧全景，城楼、箭楼、弧墙轮廓、东闸入口和门外地形同框。"
        },
        {
          "file": "anding-approach.jpg",
          "source": "https://imagenfs.thepaper.cn/image/13/547/244.jpg",
          "sha256": "cb63356b975ce38e1abb986e628ed3c7e1c544e5b82c70674d8254675aec1ad7",
          "observation": "1890年接近外院照片，曲墙下开敞路与车马比例可辨。"
        }
      ],
      "deduplication": "北京内城北垣偏东安定门，同北垣偏西德胜门为不同节点。按旧外瓮城全组一次计，拆后断墙和两张旧照不增计。",
      "layout": "北侧弧墙向外凸起，连南端城楼与北端箭楼，东月墙设单一闸门，房屋及堡墙没有侵占外围开路。",
      "proportion": "史料给院东西约68米、南北约62米，外院比例较接近方形，和德胜门狭长进深有明确对照。这里的取值仅随原来源记录。",
      "facade": "大段砖台由高低差、垛口和侧门分节，箭楼四排箭窗，城楼更通透，两端体量彼此可辨。",
      "roof": "两座主楼均为重檐歇山体系，东闸楼为较低硬山瓦顶，院落保持露天。",
      "material": "旧照可核高砖台和整体砌面。瓦色据建筑说明，不从褐色底片推断颜色。",
      "circulation": "东闸从侧面入院，折向主城楼下门洞再入内城；史料把上城马道放于城楼内侧两翼，独立于外闸路线。",
      "terrain": "外缘城壕旁低地向北展开。1890年照片可辨城墙转角与路边高差，未判历史坡率。",
      "transfer": "横向墙段、院内留白和高位塔楼构成可读比例，可和窄长型门院交叉比较。"
    }
  ],
