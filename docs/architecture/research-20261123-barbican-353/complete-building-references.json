  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-BEIJING-XIBIAN-OLD",
      "identity": "北京外城北垣西肩西便门，历史主楼、清后期箭楼与窄瓮城",
      "sources": [
        "https://m.thepaper.cn/newsDetail_forward_3637475"
      ],
      "deduplication": "北京西北肩西便门计一处。不同于外城东北肩东便门和内城西直门，大通桥也属于另一处水系。",
      "evidence": [
        {
          "file": "xibian-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/910/317.jpg",
          "observation": "1750年图示半圆小院附在笔直城墙外、护城河由北绕过，瓮城口可辨，照片所见的清后期箭楼晚于此图。",
          "sha256": "8d2db043d351e21ae0ad042f99adb40fc61a44d921425d9209eef5369f715f25"
        },
        {
          "file": "xibian-tower.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/910/320.jpg",
          "observation": "1900年朝箭楼外墙拍摄，券洞、连续弧墙、砖护岸与小式低屋顶同框。",
          "sha256": "6f14ce7a721a1c6c0e0014c8be8d467cadf5f4293b92c2bb4738e6bf0cc23660"
        },
        {
          "file": "xibian-inner-tower.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/910/328.jpg",
          "observation": "1920年南向内侧街前，主楼及过木方洞正对街，内外门之间仍可顺轴看出。",
          "sha256": "7a7926b24ef3c822e49c90e5003d74c3e1167195b4e15e7170eaf289d9a73b03"
        },
        {
          "file": "xibian-court.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/910/338.jpg",
          "observation": "1921年狭短院内的砖券与驼队，证实地面实际供行人与牲畜通过。",
          "sha256": "f061588935167a46f6015b2431d4ee77eae9158dc6930a54d781821afdaaba19"
        },
        {
          "file": "xibian-wall.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/910/340.jpg",
          "observation": "1921年外侧弧面根部与笔直外郭长墙分开，外场有小棚及驼队。",
          "sha256": "62740d10846a4755f2c7c39500c13584580599870cf40b4b2f070ac53d29d57d"
        }
      ],
      "layout": "紧凑半圆墙像浅弧接在北墙外，主楼方口与外箭楼券口居中对望。清后期箭楼体量在围墙上集中于门洞。",
      "proportion": "资料记东西宽30米、南北长7.5米；比东便门更浅，短围院仍能形成两道清楚的门限。",
      "facade": "外券洞与转角砖砌连成一体，内城台方口上是低矮门楼，主楼与箭楼窗洞和入口差别清楚。",
      "roof": "主楼单檐歇山，箭楼单檐硬山，均三间小式，旁边棚屋比墙低。",
      "material": "老照片可看清砖墙、券砖层、木檩和瓦，老墙脚的堆土与可通行路面不同。",
      "circulation": "两道门以短轴相接，院外才转向西北沿墙一带。驼队写真可作校验门洞回旋余量的尺度提示。",
      "terrain": "外城护城河沿北边绕过，其东水关有压桥并接内城西壕分流；水关不计作单独城门。"
    },
    {
      "id": "BOSS02-FORT-CN-BEIJING-FUCHENG-OLD",
      "identity": "北京内城西垣阜成门，1935年拆箭楼前的完整门防组",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_2708504"
      ],
      "deduplication": "平则门按同址历史名称合并。西垣较南节点与北侧西直门、外城西垣广安门及外城北肩西便门分开。",
      "evidence": [
        {
          "file": "fucheng-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/12/920/499.jpg",
          "observation": "1750年图上西箭楼、东主楼、北翼侧闸、两马道及城外壕桥都在同框，纸损处可用晚期老照片补认。",
          "sha256": "527b2669fd00c858f11292488efdbd72d607752c5c6649642da23d2b5acea9d7"
        },
        {
          "file": "fucheng-north.jpg",
          "source": "https://imagenfs.thepaper.cn/image/12/920/501.jpg",
          "observation": "1870年西北面，箭楼、主城楼与屋墙连廊完整，可见北墙上低小闸楼。",
          "sha256": "74751f8600649a15dfdd0255f56a8124ee788d3caca1b39f1c8fdd2345ac9881"
        },
        {
          "file": "fucheng-south.jpg",
          "source": "https://imagenfs.thepaper.cn/image/12/920/518.jpg",
          "observation": "1921年西南面两主楼、南段围墙及低处河面同框，墙根有低屋。",
          "sha256": "1203185fd88d83d49924e3d0e881d6053292109b6cc492b101ad1a40d2e359c7"
        },
        {
          "file": "fucheng-court.jpg",
          "source": "https://imagenfs.thepaper.cn/image/12/920/521.jpg",
          "observation": "1922年北闸院内券口、沿边缸瓦市与院内角落小屋，直路于闸口后折进主院。",
          "sha256": "c4868fe7cf44a9459eb2b67d41b8dbcff5b32a63eea8de751e74d38ab352f448"
        }
      ],
      "layout": "东西两端双楼与西侧圆角围院，北翼以侧闸入院，东北角庙屋沿墙布置。",
      "proportion": "资料记东西65米、南北74米。市场摊位在厚墙下可提供人的尺度，同时保留宽院。",
      "facade": "箭楼四排窗列、连续砖垛、低闸券洞和主楼木柱廊各有用途。",
      "roof": "主楼三滴水重檐歇山，外楼重檐歇山，低闸硬山，瓦屋与无覆顶的庭院有明显层次。",
      "material": "照片明确砖砌卷口、木屋和土岸。灰筒瓦与绿剪边据文献，未从黑白照片推断。",
      "circulation": "过壕后沿城外路折入北闸再折向东端主门。缸瓦堆与棚屋贴墙使行走转折可辨。",
      "terrain": "壕沟与岸坡外绕圆角，院内外营生可用墙下平地而不阻断跨壕进城。"
    }
  ],
