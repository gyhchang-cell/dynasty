  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-BEIJING-CHAOYANG-OLD",
      "identity": "北京内城东垣南门朝阳门，1906年复修后至1915年拆瓮城前的全组",
      "sources": [
        "https://xinwen.bjd.com.cn/content/s62d6432be4b0cd8d0ea6abd5.html",
        "https://www.sohu.com/a/124948995_355040"
      ],
      "deduplication": "齐化门历史同址只计一次。箭楼炮损、修复、整组拆除后的独立楼各属于同门不同阶段。区别于东直门的内城东垣北节点。",
      "evidence": [
        {
          "file": "chaoyang-whole.jpg",
          "source": "https://static.bjd.com.cn/dams-res/editing/image/202312/31/6590cf14d5de908f0733f5d4.jpeg",
          "sha256": "9da5e0b51eea55b16e82e6c63f41e5e0e306d9cb164c26d3c735f0071dd607d5",
          "observation": "1906年南面，楼与楼之间的月墙及城壕同框，低屋成排沿河。"
        },
        {
          "file": "chaoyang-wall.jpg",
          "source": "https://static.bjd.com.cn/dams-res/editing/image/202312/31/6590cf2cd5de908f0733f618.jpeg",
          "sha256": "e8148adff1006bce92ed167a9a72be584ac08b2441eb247b59ed1d5bc14e9691",
          "observation": "1900年后、箭楼尚损。东北面仍清楚呈现垛墙、砖基和临河关厢。"
        },
        {
          "file": "chaoyang-court.jpg",
          "source": "https://static.bjd.com.cn/dams-res/editing/image/202312/31/6590cf28d5de908f0733f612.jpeg",
          "sha256": "616483211ab9b966620f9a38ab27d67fa5ac430b00ffaa9f6ccddcad72acee88",
          "observation": "1901年从箭楼台向西观察主楼木廊、三层瓦檐及高砖台比例。"
        },
        {
          "file": "chaoyang-sluice-gate.jpg",
          "source": "https://img.mp.sohu.com/upload/20170122/6f0d7128f89d40b896ba2c6bb238a2a1_th.jpeg",
          "sha256": "3adb0bb2bb31da3de9ae8d28be701da5ee50444ee1ba872d4ac1f521dffc2154",
          "observation": "约1907年瓮城内，主门和墙侧闸券洞分置，市场沿墙展开。"
        }
      ],
      "layout": "东西向的两端高楼之间接敞院，北侧设低闸楼，南墙连续。",
      "proportion": "两座高楼与低墙、棚屋对比鲜明，历史照片不用于推算尺寸。",
      "facade": "主楼开敞柱廊与箭楼小窗阵列对比，券洞位置有意偏离箭楼正面。",
      "roof": "高楼多层瓦檐与低矮单檐附属屋并存，院心无顶。",
      "material": "照片能核查砖墙、木廊和瓦片纹理，配色未由上色照片反推。",
      "circulation": "石桥跨护城河后，经北侧闸进入围院再转向西侧主门。内侧南马道连接高台。",
      "terrain": "城壕与防墙间形成可用的低矮沿岸带。市场还占据敞院边角，避免把入口出口都塞在同一轴上。"
    },
    {
      "id": "BOSS02-FORT-CN-BEIJING-DONGZHI-OLD",
      "identity": "北京内城东垣北门东直门及其矩形瓮城",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_2772413"
      ],
      "deduplication": "旧称崇仁与后期东直按同一门址。北京东垣北节点，区别于朝阳和外城东北肩东便门，也与西侧镜向的西直门分开。",
      "evidence": [
        {
          "file": "dongzhi-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/13/485/217.jpg",
          "sha256": "f315dbaaf6653c506726ed77b8068e70c385203a26810ea72d2823c9f845abba",
          "observation": "1750年京城图中两高楼、正交院墙、右侧闸与护城河石桥一并标出。"
        },
        {
          "file": "dongzhi-gate.jpg",
          "source": "https://imagenfs.thepaper.cn/image/13/485/225.jpg",
          "sha256": "ce87cb1a63ee6c349c1a62bc741fc3a8c0885b3ffbe68fdea458c8b1ee73cf8c",
          "observation": "1911年南侧墙低闸及券洞在左，箭楼台在右，凹低护城河在前。"
        },
        {
          "file": "dongzhi-whole.jpg",
          "source": "https://imagenfs.thepaper.cn/image/13/485/227.jpg",
          "sha256": "635546cdf53c55d11a033b64e52857699a557ec7ad7a55cf11600e9676b2d8c7",
          "observation": "1911年拆除前远景，主城楼和箭楼隔一段院墙，两楼尺度与前景关厢明显不同。"
        }
      ],
      "layout": "四角皆直角的矩形敞院，东端高箭楼，西端主城楼，南翼闸楼。",
      "proportion": "照片和地图可见双楼院落的正交开间，研究记录将箭楼连台记为30米，未用影像重新定尺。",
      "facade": "箭楼外三面设多排箭窗，南侧通道为砖券。二者在同一护墙上分别承担瞭望和通行。",
      "roof": "箭楼是重檐歇山，南闸硬山的较低屋顶在照片中可辨。",
      "material": "砖台、木楼、灰筒瓦与绿琉璃剪边。装饰颜色取自史料描述。",
      "circulation": "石桥过壕后沿墙折入南券门，并再折往西主门。地图显示主楼城内两侧马道。",
      "terrain": "壕沟位置低于外侧道路、闸口和防墙，桥面先落在外场而后才入侧闸。"
    },
    {
      "id": "BOSS02-FORT-CN-BEIJING-DONGBIAN-OLD",
      "identity": "北京外城北垣东肩东便门，清代加箭楼后的紧凑护院",
      "sources": [
        "https://www.thepaper.cn/newsDetail_forward_3585176",
        "https://wwj.beijing.gov.cn/bjww/resource/cms/article/bjww_362762/10861804/2020090816551232929.pdf"
      ],
      "deduplication": "归入同一东便门址，地图所绘未建箭楼阶段与1920年照片分期互证；大通桥、水关、内城东南角楼作为环境不单计。",
      "evidence": [
        {
          "file": "dongbian-map.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/720.jpg",
          "sha256": "5e65a4f40027a37ddc35cf436e77d431a5ca542ae3da2cf778e96f812120ad08",
          "observation": "1750年地图中环墙、内外中轴通口、邻近三孔水关与桥的相对位置明确。"
        },
        {
          "file": "dongbian-whole.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/738.jpg",
          "sha256": "3a8583951bde8d3a22cb12f9a6f1c963b6355195613baffa73537dd03d066083",
          "observation": "1900年沿北垣向东侧俯视，斜马道、主楼和南北向前后门位置可交叉复核。"
        },
        {
          "file": "dongbian-gate.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/735.jpg",
          "sha256": "75632461ca490152699c071a323a66fe11e838598ce4d348dd547cf1e697885f",
          "observation": "1900年外侧门洞与箭窗，显示外面为券口和厚砖台。"
        },
        {
          "file": "dongbian-1920.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/762.jpg",
          "sha256": "aacd662edeaf297f07e2e9f9cb51093e94b8d80b4f5071dca52d438f22be694d",
          "observation": "约1920年岸边远景，裙墙曲面与低岸挡砌可辨；楼身受遮蔽。"
        },
        {
          "file": "dongbian-north.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/768.jpg",
          "sha256": "25dd4aa7f1db1986298b34f9e37db6ee1f17bf16df5d2208170585c7912cfef2",
          "observation": "约1920年北侧大通桥三孔与远处城墙、楼体同框，反映水关来路。"
        },
        {
          "file": "dongbian-court.jpg",
          "source": "https://imagenfs.thepaper.cn/image/21/346/756.jpg",
          "sha256": "e808d3de5bd1a6890d1dffb56b80b36c5e683c0c3c0d583eeb2338674d6240a7",
          "observation": "约1920年从院内拍摄，门额下为过木方门，瓦檐与箭楼外砖券形成对照。"
        }
      ],
      "layout": "外郭北肩接内城东垣，在外郭城墙外鼓出半圆。1750年的瓮城已设前后直通门，清后期外口上加单层箭楼。",
      "proportion": "资料给出宽27.5米、长15.5米，附着式短院，显著小于朝阳门、东直门尺度。",
      "facade": "外券口上为两排箭窗，主楼门下为方口。不同外形能提示玩家目前所处的内外边界。",
      "roof": "小式城楼单檐歇山，外侧箭楼单檐硬山，围院保持露天。",
      "material": "历史影像可见砖墙、凸出石栏与筒瓦屋面，水关和过水桥使用拱形砌筑。",
      "circulation": "桥面大致对着轴向外门，经小瓮城到正门；内侧另有登城马道。短直流线适合低等级门防场景。",
      "terrain": "紧邻内外城汇水处，砖墙曲面与低岸挡墙衔接，大通桥三孔促成过水与过人两层组织。"
    }
  ],
