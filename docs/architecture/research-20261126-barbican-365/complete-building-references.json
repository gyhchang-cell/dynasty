  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-YANMEN-DILI-BARBICAN",
      "identity": "山西代县雁门关小北门瓮城和关城西门地利门",
      "sources": [
        "https://m.sohu.com/a/219050759_488263",
        "https://sx.people.com.cn/n2/2024/1218/c189134-41079059.html"
      ],
      "deduplication": "总平面图在关城北侧单独标注瓮城城门（小北门），及邻近的西门（地利门）。只按两门之间这一组入口计一例。天险门及更外层围城不另计。",
      "evidence": [
        {
          "file": "yanmen-plan.jpeg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20180126/220084498bae4f7092c958dc70e9aa6f.jpeg",
          "sha256": "28ba929f76d14b1de37e9940a0255d14986d9de07a7f5e73cb7c3b6cffff318e",
          "observation": "根据忻州市雁门关风景区管理局资料绘制。总平面可追踪北来古驿道、小北门所在的围合边和关城西门轴线。"
        },
        {
          "file": "yanmen-admin.jpeg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20180126/9968e98717ec4d1b86c89732762ac81b.jpeg",
          "sha256": "941ff838b9ff74bca30108e8c9b21c289c9f260c23d2f72d3b4f33cd70ed271f",
          "observation": "管理局提供、标为地利门。主券上方的垛墙、两层檐口、右落阶与坡地接续均可见。"
        }
      ],
      "layout": "北来山路在小北门转入前围合，随后到关城西门。前围合边界顺山势转折，开口和内门券分处两道墙线。",
      "proportion": "门楼底宽与上层檐身分级。狭窄驿道在内门前获得短暂的露天过渡空间。",
      "facade": "地利门券洞上有高砖城台和垛口。门楼下层较宽，侧阶贴城台走。",
      "roof": "地利门楼有深瓦重檐和翘起檐角，前院开敞。",
      "material": "资料记载关城为条石基座、夯土芯和包砌城砖。实拍可辨墙面砖层与暗瓦形成反差。",
      "circulation": "由北来古道到小北门，再在院内调整方向到地利门。穿门后可沿陡阶到宁边楼。",
      "terrain": "总图等高线显示道路借山谷收拢，关城外墙接上两侧山坡。"
    }
  ],
