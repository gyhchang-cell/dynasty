  "new_entries": [
    {
      "id": "BOSS02-FORT-KR-SEOUL-HEUNGINJIMUN",
      "identity": "韩国首尔汉阳都城兴仁之门（东大门），现存门楼、半月瓮城和北端侧口",
      "sources": [
        "https://seoulcitywall.seoul.go.kr/en/wallcourse/3.do",
        "https://heritage.go.kr/heri/cul/culGuidePostDetail.do?ccbaCpno=1121100010000&ccgbGbtype=IND&ccgbGbtypeNo=1&pageNo=1_5_0_0",
        "https://contents.history.go.kr/mobile/kc/view.do?code=kc_age_30&levelId=kc_r301000",
        "https://archive.visitseoul.net/ko/contents/ARP007n21",
        "https://data.si.re.kr/photo/05x11417ca4000"
      ],
      "deduplication": "흥인지문、Heunginjimun 和 Dongdaemun 为同一处。汉阳都城唯一有瓮城的门组，与此前水原华城四处不同址。1907年被拆的两翼大城墙不计入该入口组。",
      "evidence": [
        {
          "file": "seoul-drone.jpg",
          "source": "https://archive.visitseoul.net/upload/encoding/image/2023/12/ed4308c4c54849a7ab036e70d0d6773c.jpg",
          "sha256": "314475be2f960e5fc15a8cb35f1207bf78916ac3ad06e149b9353f5c2dffb2bc",
          "observation": "首尔旅游档案斜俯拍。中轴砖石券、北端错位围墙缝和院面可辨。"
        },
        {
          "file": "seoul-aerial.jpg",
          "source": "https://data.si.re.kr/sites/default/files/photos/05X11417Ca4000.jpg",
          "sha256": "4558221385d8b2cb99d0c3c1e5698b43e9381849389c51b145d347c1262d1de6",
          "observation": "首尔研究数据服务反向广角全景，确定北端短开口、现状孤立台地及邻近残存城墙的不同位置。"
        }
      ],
      "layout": "低半月墙包住城市外侧的主券前场，北端留侧口，南端连接主门墙线。",
      "proportion": "弧墙约在主门石台量级以下，门楼屋顶高出围墙，让入口前仍可识别建筑主体。",
      "facade": "弧形外墙以水平石层和墙顶压边为主。主墙仅有中央暗券，木构楼身分两层。",
      "roof": "两层宽瓦檐平行展开，瓮城无盖。",
      "material": "石墙浅灰，主门台为整齐花岗岩石作，门楼为木构与深瓦，院心现状露土。",
      "circulation": "韩国国史编纂委员会记载由北端侧入。之后需转入半月院，再走主券轴线。仅据史料描述原动线。",
      "terrain": "汉阳都城东侧低地。现状门组由道路环绕，与北侧高起的墙段隔开。"
    }
  ],
