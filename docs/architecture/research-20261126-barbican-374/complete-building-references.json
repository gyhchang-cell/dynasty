  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-LINHAI-CHAOTIAN",
      "identity": "浙江临海台州府城西门朝天门与一号敌台下的瓮城",
      "sources": [
        "https://www.cssn.cn/kgxc/kgxc_xccz/202207/t20220728_5430294.shtml",
        "https://m.sohu.com/a/194377469_578974",
        "https://www.sina.cn/news/detail/5163013846339798.html",
        "https://wenhui.whb.cn/zhuzhan/jjl/20190821/284656.html"
      ],
      "deduplication": "临海西门街末端、一号敌台下的沿江门组。正对老西门街，位置与南城墙镇宁门、已计兴善门和重庆同名门独立。",
      "evidence": [
        {
          "file": "chaotian-air.jpeg",
          "source": "https://5b0988e595225.cdn.sohucs.com/q_70,c_zoom,w_640/images/20170925/f675e93abf5f4a1ab2196f14b95dd4d7.jpeg",
          "observation": "金孝木黄昏照片，图注明确为朝天门。整座外院和两头回接、灵江、城垣以及上层敌台清楚可辨。",
          "sha256": "80216d455647b7cb020b887305a9b5cbe8df3e796b968af8f9c7795f3f5e52b3"
        },
        {
          "file": "chaotian-court.jpeg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20170925/093c617071584160b43e0e06506e7795.jpeg",
          "observation": "宋海风从券口望向同组墙面，前后可见两个尺度不同的券口以及远处一号敌台。",
          "sha256": "57b862a9b94d1da9058177b1f1c3b67f0596926c4ae93f70d39998c18ecb2d36"
        }
      ],
      "layout": "文保调查将平面记作圆角方形。斜俯照可见大半院界向江侧外凸，两端接回与江平行的主垣。",
      "proportion": "外院宽度明显大于券洞。墙顶仅一线垛口，山侧一号敌台高出整组门院。",
      "facade": "内外券有透视叠层，城头垛口在连续圆弧上转向。券后有露天高开间。",
      "roof": "图证所见瓮院露天，近景的两个券洞有拱顶，上方没有可核实的当代瓦顶门楼。",
      "material": "灰褐砖石墙体、石券、木门及铺地，修缮年份不同的段落色泽不同。",
      "circulation": "走西侧外城沿江路，从侧券入院，再转入主墙券接西门街。现场报道有市民持续使用，明清防洪闸槽由考古调查确认。",
      "terrain": "城墙从北固山向灵江落下，院落紧贴河岸平缓地段。弧形迎水墙与上方坡道在不同高度。"
    },
    {
      "id": "BOSS02-FORT-CN-LINHAI-ZHENNING-REPAIRED",
      "identity": "浙江临海台州府城南墙镇宁门与修缮后圆角瓮城",
      "sources": [
        "https://www.cssn.cn/kgxc/kgxc_xccz/202207/t20220728_5430294.shtml",
        "https://www.sina.cn/news/detail/5163013846339798.html",
