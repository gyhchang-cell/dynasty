  "new_entries": [
    {
      "id": "BOSS02-FORT-CN-DATONG-QINGYUAN-RESTORED",
      "identity": "山西大同古城西门清远门复建的整组门防",
      "sources": [
        "https://www.sohu.com/a/379304844_99892258",
        "https://www.pingcheng.gov.cn/pcqrmzfz/wmdt/202009/548dcfea073a407a803483feb7e356db.shtml",
        "https://www.dt.gov.cn/dtszf/stdt/201811/cbe3380bd8014f1cb4979371687dee29.shtml"
      ],
      "deduplication": "与已计东侧和阳门相隔整座古城，为独立的西向门组。现代复建、现状多角度、主门以南北开辟的便门、展销临设都不单计。复建形制不作为原明清遗构证明。",
      "evidence": [
        {
          "file": "qingyuan-exterior.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/e34812c0077b4724ab550e9d536fe537.jpeg",
          "sha256": "e94127e75f4e2d917f69be2e3786e1963b177810ebaef891c6cdbed44bfc30ce",
          "observation": "城外石栏桥、低壕沟和月楼同框。月楼小窗列与下方券口分层，远处视线被外墙截住。"
        },
        {
          "file": "qingyuan-side.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/2662f185f9c2474b906ab3dba8c2607f.jpeg",
          "sha256": "4ceb0728d31653dadb313806b4c928737f87688ee374d01236b1b78c4c552a51",
          "observation": "通过外门后见直角相接的高墙和偏开的瓮城券门，地面仍保留聚集空间。"
        },
        {
          "file": "qingyuan-inner.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/fbdbd915c2814620a320acea45012a71.jpeg",
          "sha256": "9a0c86a8f42ab017551108b9594b120349aac2f17999f4fbd84efe076711d0e4",
          "observation": "向瓮城内部看见平整开敞长院、成排相接的砖墙及靠边布置的展摊，院心留通。"
        },
        {
          "file": "qingyuan-court.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/8c443bbfb6cb4619b94220c758625d5e.jpeg",
          "sha256": "a7a79adfc3a9a5a2977a8678634e7470f6a7fa6d833eaf426a094bea085c679c",
          "observation": "从内院回望侧闸，深券洞与其上的屋檐部分可见。"
        },
        {
          "file": "qingyuan-main.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/50fe94034e00448c8205a1f816b54c5d.jpeg",
          "sha256": "e50d23b40b0290e931d526e76f50d2232fc82a161e949d00111f089d242645cf",
          "observation": "内侧正城门完整的高大三重檐、正中券口和门额，尺度高于另两道门。"
        },
        {
          "file": "qingyuan-main-detail.jpg",
          "source": "https://5b0988e595225.cdn.sohucs.com/images/20200311/105498a249154e7f9469560636f235f3.jpeg",
          "sha256": "b6a7beb21b76e058074a40667c03200a5c0944f59256eac387d27098f7bf4efd",
          "observation": "内侧主楼和长城墙的直接接合在斜角照片上可辨。"
        }
      ],
      "layout": "主城西向门之外，矩形内瓮城和矩形外月城嵌套。过外门以后需折入内瓮城侧闸，外场不与主券构成长穿堂。",
      "proportion": "三座门楼具有主楼高、外楼及侧楼低的层级。照片按人物、桥栏和砖墙来校读相对尺度，旅游文中长度估计不用于控尺。",
      "facade": "外楼多排小窗、月城高垛墙、内侧主楼木廊和层叠檐口分层；券洞开在厚墙内，门和墙的体量可辨。",
      "roof": "主城门三层檐口明显，外月楼见更低双檐；院内两侧临展棚比围墙低得多。",
      "material": "现状砖墙、较浅石栏、铺院方砖与木构楼可区分。古城文物资料中的夯土砖包构法记为历史背景。",
      "circulation": "先跨外沟进月城，沿转折进瓮城侧闸并从内院进入主券。用过门视点及回望照片互证内外两段折线。",
      "terrain": "外侧护城河和栏桥比墙体低，墙基、排水边缘与大面积平院分层。内院临时摊位靠边，仍能保持主通行带。"
    }
  ],
