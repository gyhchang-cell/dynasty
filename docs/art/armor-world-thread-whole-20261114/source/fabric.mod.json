{
  "schemaVersion": 1,
  "id": "dimdoors",
  "version": "5.0.2",
  "name": "DimensionalDoors",
  "description": "Bend and twist reality, creating rifts, pocket dimensions, and much more",
  "authors": [
    "StevenRS11",
    "SenseiKiwi",
    "Zixiken",
    "Waterpicker",
    "Robijnvogel",
    "ZombieHDGaming",
    "Runemoro"
  ],
  "contact": {
    "homepage": "https://dimdev.org/",
    "sources": "https://github.com/DimensionalDevelopment/DimDoors",
    "issues": "https://github.com/DimensionalDevelopment/DimDoors/issues"
  },
  "license": "MIT",
  "icon": "assets/dimdoors/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.dimdev.dimdoors.DimensionalDoorsInitializer"
    ],
    "client": [
      "org.dimdev.dimdoors.client.DimensionalDoorsClientInitializer"
    ],
    "modmenu": [
      "org.dimdev.dimdoors.client.config.ModMenuImpl"
    ],
    "cardinal-components": [
      "org.dimdev.dimdoors.DimensionalDoorsComponents"
    ],
    "fabric-datagen": [
      "org.dimdev.dimdoors.datagen.DatagenInitializer"
    ]
  },
  "mixins": [
    "dimdoors.mixins.json"
  ],
  "depends": {
    "fabricloader": "\u003e\u003d0.4.0",
    "fabric": "*"
  },
  "accessWidener": "dimdoors.accesswidener",
  "custom": {
    "cardinal-components": [
      "dimdoors:dimensional_registry",
      "dimdoors:counter",
      "dimdoors:chunk_lazily_generated",
      "dimdoors:player_modifiers"
    ],
    "waila:plugins": {
      "id": "dimdoors:wthit_plugin",
      "initializer": "org.dimdev.dimdoors.client.wthit.WthitPlugin"
    }
  },
  "jars": [
    {
      "file": "META-INF/jars/flow-math-1.0.3.jar"
    },
    {
      "file": "META-INF/jars/jgrapht-core-1.1.0.jar"
    },
    {
      "file": "META-INF/jars/poly2tri.java-0.1.1.jar"
    },
    {
      "file": "META-INF/jars/Matrix-1.0.0.jar"
    },
    {
      "file": "META-INF/jars/cloth-config-fabric-7.0.72.jar"
    },
    {
      "file": "META-INF/jars/cardinal_base-318449-3801039.jar"
    },
    {
      "file": "META-INF/jars/cardinal_item-318449-3801043.jar"
    },
    {
      "file": "META-INF/jars/cardinal_entity-318449-3801042.jar"
    },
    {
      "file": "META-INF/jars/cardinal_level-318449-3801044.jar"
    },
    {
      "file": "META-INF/jars/cardinal_world-318449-3801046.jar"
    },
    {
      "file": "META-INF/jars/cardinal_chunk-318449-3801041.jar"
    }
  ]
}