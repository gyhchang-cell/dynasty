  "observations": [
    {
      "semantic_group": "wizard_hat_robe_variants",
      "prior_group": "wizard_hat_robe_variants",
      "credit": "APPEND_TO_PRIOR_GROUP_ZERO_NEW_DESIGNS",
      "cases": [
        "wizards:arcane_robe",
        "wizards:fire_robe",
        "wizards:frost_robe",
        "wizards:netherite_arcane_robe",
        "wizards:netherite_fire_robe",
        "wizards:netherite_frost_robe",
        "wizards:wizard_robe"
      ],
      "observation": "七套均为同一宽檐折尖帽、开襟双长衣片、直长袖、分腿和短靴剪影，17体块同geo。普通巫师蓝色少量大块离散阴影；奥术紫底浅紫符纹，火袍红橙中线，冰袍青底大片浅蓝覆肩/帽顶；下界合金版在对应元素布底上增加灰袖带、灰靴扣和帽尖灰纹，几何不变。原生图标全16×16，7图集均64×64，正/45/侧/背/黑剪影共7页实际查看。正面胸襟与背面圆符/弧形块、袖口水平带相呼应。帽与袍的上下断开是未显示人体的静态全套源组装，不能判穿戴断头。",
      "application": "用于布/锦/海丝目标理解领襟、内衬、袖口和下摆的少量大色块及正背材料连续。普通蓝袍较贴近少量明暗的要求；紫纹/下界小灰格更碎，不直接复制。长袍有明确功能，不能按普通短胸甲统一抹掉旧L2。保持原版目标自身肩宽和槽UV；不把这顶宽帽作为所有甲的头盔比例。",
      "binding_observation": "7个CustomMaterial名称→共享WizardArmor→RenderProvider→WizardArmorRenderer→WizardArmorModel和textures/armor/{name}.png的静态材料/资源关系已读；7个factory各创建4种不同中间命名ArmorType。未从当前包闭合外部Spell Engine Armor$Set的注册实现，也没有把中间命名字段序号当头胸腿靴已验映射。getAnimationResource返回null，registerControllers直接return；包内armor_idle.json只留源上下文，不宣称动画被选择或运行。该版本是Fabric/AzureLib而非Dynasty的Forge/GeckoLib。"
    }
  ],
