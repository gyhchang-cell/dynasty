  "comparisons": [
    {
      "prior": "D79 iron/leather chosen plate",
      "observed_prior": "silver U helmet, compact broad chest, connected waist/two straight legs, separated tall boots; brown maille bands are composited material parts",
      "new_difference": "Ashen goggles are two gold eye circles with overhead strap, black cloak has central gold panel; black pants gold knee fronts and black separate toes. Cape geometry is three actual custom panels, no plate maille component assembly.",
      "overlap": "paired shoulders, two-leg negative space, discrete metallic highlights are common grammar; cannot count a new design merely for black/gold"
    },
    {
      "prior": "D88 evocation robes",
      "observed_prior": "blue bent tall hat with brown band/yellow buckle, open front yellow edging/dark red centre, full blue leggings/brown boots",
      "new_difference": "goggles replace full hat; short central gold front and broad black side masses versus robe opening; custom back cape panels and knee/hip protection",
      "overlap": "cloth with bright centre/border and robe-like rear silhouette. New namespace or cape alone does not prove global independence"
    },
    {
      "prior": "D88 mercenary",
      "observed_prior": "silver nose-strip U helmet, asymmetrical brown shoulder/back, leggings icon knee pads only, silver separated boots",
      "new_difference": "goggle straps with split golden lenses; gold kneecaps on connected black waist/leg icon; black fabric cape replaces hard brown backplate",
      "overlap": "knee-only physical geometry and shoulder/glove blocks. Not a full vanilla leggings UV template"
    },
    {
      "prior": "D88 reinforced mail",
      "observed_prior": "silver top bar U helmet, checkered mail chest, leggings belt-only, flat short grey boots",
      "new_difference": "non-mail black cloth base, large gold centre/knees and specific goggle head identity, visible two-leg gap icon",
      "overlap": "waist fastening and paired feet are common; no independent credit from slot count"
    },
    {
      "prior": "D90 normal hunter coat",
      "observed_prior": "very dark black short-brim hat/long open coat/buttons, black straight pants brown ankle marks, separate black boots, L2 brown torso clothing patch",
      "new_difference": "head is goggles not brim; larger gold chest and knee blocks are readable at16px; cape is separate3-panel custom body child rather than assumed default long-coat mesh",
