{
  "id": "dualswords-active-stack-parry-riposte-reverse-grip",
  "status": "SUPERSEDED_BY_REVIEWED_PROPOSAL_NOT_ACCEPTED",
  "created_utc": "2026-10-30T16:45:51.924477+00:00",
  "target": "mandarin_duck_axe",
  "selected_scope": "一项实际使用手武器的短时格挡→近身反击→冷却退出→第一/第三人称实际物品反握与格挡姿态整链；不拆方法或四手视角计数。",
  "source_version": "Dual Swords1.1.2 / Minecraft1.20.1 / Fabric0.15.6；不是Forge兼容实现。",
  "chain": [
    "fabric.mod.json指定DualSwordsMain与mixins；初始化注册PARRY/RIPOSTE等附魔。",
    "ItemMixin.use读取真实hand stack；有PARRY设currentHand，getUseAction为BLOCK，getMaxUseTime为10×附魔级。",
    "LivingEntityMixin.quickParry将原版盾等待改为至少2tick；preventParry仍保留原阻挡判定并额外拒绝bypasses_parry及禁盾近战。",
    "damage TAIL的实际blocked局部标志与activeItem附魔触发：直接Living攻击者且<=4.5才结算riposte；特定投射物分支只处理速度。",
    "回调以实际activeItem耐久/冷却、sweep状态和stopUsingItem退出，反击伤害类型列入bypasses_parry阻断互相无限弹反。",
    "客户端声明的HeldItemRendererMixin结合实际hand和mainArm变换当前物品矩阵；HeldItemFeatureRendererMixin在真实held item绘制调用前变换，只有正在使用的同一stack额外45度格挡。"
  ],
  "important_distinctions": [
    "弹反入口不要求双手都有DualWeapon；Daisho另在OFFHAND且主副手都为dual时加伤，不能把两条路径合称两武器共同格挡。",
    "firstperson按hand映射mainArm并要求swingProgress==0才反握；thirdperson对带附魔持物常态反握，仅activeItem==stack时加格挡角。两个视角不是共用一个固定世界偏移。",
    "攻击者damage返回未被使用，后续耐久/效果/动画不是反击伤害成功回执；缺少距离资格也仍执行部分后续近战回调。",
    "原版盾判定包含来源朝向、穿透等；只是被格挡不能当作目标受伤成功。"
  ],
  "limitations": [
    "尚需结合同版CombatPlus依赖确认正常物品资格与辅助回调，完整主路径已读但提案未封口。",
    "本地引擎源是Forge映射比较资料；Forge isBlocking额外依赖SHIELD_BLOCK ToolAction，不能声称Fabric注入可直接移植或已验证。",
    "未启动外部模组/Java/游戏，不证明Mixin ordinal适配、网络同步和实际像素效果。"
  ],
  "dedup": {
    "presearch": "presearch-dedup.json",
