  "complete_this_batch": [
    "补读GrappleController先前未读的碰撞/台阶/地面/跳力/斥力/火箭/墙跑辅助。",
    "AIR控制器剩余方法、ClientControllerManager与ClientProxy辅助入口。",
    "SegmentHandler、Vec、GrappleCustomization、Config及规则辅助全文。",
    "四个实际注册C2S的处理与消费；准确Forge47.1.0的方向校验、sender和enqueueWork链。"
  ],
  "physics_findings": [
    {
      "topic": "约束与运动责任",
      "observation": "GrappleController在客户端按折点至玩家的剩余绳长限制径向运动、超buffer则unattach；考虑马达、跳跃和climb。服务器PlayerMovementMessage消费位置/速度，不在该方法重算上述约束。",
      "evidence": [
        "GrappleController.java128–520",
        "PlayerMovementMessage.java75–94"
      ]
    },
    {
      "topic": "碰撞与承重辅助",
      "observation": "normalCollisions依现有水平/垂直碰撞标记截断motion；tryStepUp用抬高/前移后的碰撞查询，必要时setPos并改old坐标。normalGround有短暂onGroundTimer；这些是客户端辅助，不是服务器重新碰撞证明。",
      "evidence": [
        "GrappleController.java536–617",
        "Vec.java207–217"
      ]
    },
    {
      "topic": "跳跃及AIR退出",
      "observation": "绳跳先改motion，再unattach并updateServerPos；AIR可因乘坐/水/熔岩/着地退出，滑铲和墙跑另有门禁。FallFlying分支unattach后没有立即return，仍能在当前方法后续setMotion/updateServerPos；不等于实测故障。",
      "evidence": [
        "GrappleController.java619–683",
        "AirfrictionController.java42–189"
      ]
    },
    {
      "topic": "向量数值范围",
      "observation": "Vec的部分构造/setPos/setMotion检查NaN并归零整向量；normalize_ip和若干原地操作没有统一检查，checkNaN不检测Infinity。changeLen在零向量时返回原对象，mult等非原地API返回新对象。不能把忽略返回值的调用视为已经改值。",
      "evidence": [
        "Vec.java13–47,111–172,200–217"
      ]
    },
    {
      "topic": "折点长度及同步",
      "observation": "SegmentHandler以三张并行列表存折点和两面朝向；update依前后tick射线求转角，受剩余长度约束，递归深度上限10；服务器增删发SegmentMessage到玩家所在区块的跟踪者。客户端按index直接增删并消费同一列表给绳renderer。",
      "evidence": [
        "SegmentHandler.java62–250,282–342",
        "SegmentMessage.java74–91",
        "RenderGrapplehookEntity.java227–254 (batch03)"
      ]
    },
    {
      "topic": "折点可变对象",
      "observation": "getBendBlock取得segments[index]引用后直接add_ip偏移，两次调用会改变原列表点。只记录实际可变语义；是否在具体玩法引出可见漂移未实测。",
      "evidence": [
        "SegmentHandler.java275–280",
        "Vec.java83–87"
      ]
    },
    {
      "topic": "自定义参数与CRC",
      "observation": "NBT和buffer按固定键表读写17个boolean与16个double，CRC32不符重置默认值。setDouble/loadNBT/readFromBuf不通过getMin/getMax钳制；CRC是内容一致性检查，不是sender授权或升级权限校验。UI限制不应自动当作服务端边界。",
      "evidence": [
        "GrappleCustomization.java16–17,191–342,388–404",
        "GrappleConfig.java23–57"
      ]
    },
    {
      "topic": "配置同步",
      "observation": "登录服务端发LoggedInMessage，按字段名排序递归编码，客户端setServerOptions，getConf优先serverOptions；客户端注销时清它。此路径同步参数，不同步玩家钩引用或控制器持久化。",
      "evidence": [
        "CommonEventHandlers.java121–129",
        "LoggedInMessage.java41–126",
        "GrappleConfig.java384–394",
        "ClientEventHandlers.java89–92"
      ]
    }
  ],
  "authority_chain": [
    {
      "layer": "注册及接收方向",
      "result": "CommonSetup将4个C2S绑定PLAY_TO_SERVER；SimpleChannel实际addCodecIndex保存方向，IndexedMessageCodec.consume在decode/consumer前调用NetworkHooks.validatePacketDirection；不匹配断开并抛出。",
      "evidence": [
        "CommonSetup.java102–118",
        "SimpleChannel.java71–77",
        "IndexedMessageCodec.java137–158",
        "NetworkHooks.java77–96"
      ]
    },
    {
      "layer": "连接sender与线程",
      "result": "NetworkInstance以Connection构造Context；Context.getSender从ServerGamePacketListenerImpl返回连接玩家；enqueueWork按接收侧工作队列执行。模组BaseMessageServer做SERVER侧检查并排队；sender null分支只日志，不统一return。",
      "evidence": [
        "NetworkInstance.java65–70",
        "NetworkEvent.java169–230",
        "BaseMessageServer.java25–40"
      ]
    },
    {
      "layer": "KeypressMessage",
      "result": "不接受任意payload owner ID；从ctx sender拿当前主手，若不是KeypressItem再取副手，再进入该物品回调。spawn的shootingEntity由这个LivingEntity实参设置。没有原发射栈唯一token或hand字段。",
      "evidence": [
        "KeypressMessage.java53–83",
        "GrapplehookItem.java118–197,378–401",
        "GrapplehookEntity.java67–84"
      ]
    },
    {
      "layer": "PlayerMovementMessage",
      "result": "必须sender.getId()==payload.entityId才消费。之后直接以Vec.setPos/setMotion改sender并resetPosition；本处理不检查attached、注册钩集合或射线/速度预算。该ID条件不能替代完整运动合法性验证。",
      "evidence": [
        "PlayerMovementMessage.java75–94",
        "Vec.java207–217"
      ]
    },
    {
      "layer": "GrappleEndMessage",
      "result": "检查sender非空、取sender.level，随后payload.entityId与hookIDs原样交manager。manager对hookIDs只检查实体存在且是GrapplehookEntity便removeServer；随后按payload.entityId扫集合，不比较shootingEntity/ctx sender。方向认证不补这一归属条件。",
      "evidence": [
        "GrappleEndMessage.java59–69",
        "ServerControllerManager.java21–54",
        "GrapplehookEntity.java146–149"
      ]
    },
    {
      "layer": "GrappleModifierMessage辅助分支",
      "result": "以ctx sender世界查询payload坐标，目标为TileEntityGrappleModifier便setCustomizationServer。该setter直接赋值并setChanged；本选定链未检查距离、解锁种类、手中物品或每参数范围。不将此辅助分支另计案例。",
      "evidence": [
        "GrappleModifierMessage.java48–56",
        "TileEntityGrappleModifier.java32–45",
        "GrappleCustomization.java330–342"
      ]
    },
    {
      "layer": "S2C接收者而非实体授权",
      "result": "GrapplemodUtils的PLAYER发指定ServerPlayer；PacketDistributor真发该连接。TRACKING_CHUNK发区块跟踪玩家。两者决定接收者，不验证GrappleEnd里的实体拥有关系，也不带折点版本号/重放恢复证明。",
      "evidence": [
        "GrapplemodUtils.java13–20",
        "PacketDistributor.java39–81,156–204,238–243"
      ]
    }
  ],
  "limits": [
    "这是公开源码的静态阅读；未编译、运行、发网络包或复现漏洞。",
    "原版连接/区块跟踪底层、其他模组注入和真实消息时序未全读或实测；不声称整个服务器已审计。",
    "已读辅助源不等于所有物理模型数学稳定，也不等于完整物品/生物模型PNG视觉参考。",
    "在本类spawn里保存shootingEntity运行时ID不是持久化owner UUID恢复；save/load/跨维/断线全生命周期仍未闭合。",
    "折点消息按列表索引而无自身版本号，正常传输次序/区块订阅/迟到实体的实际表现待验证。",
    "本记录未改外部模组与Dynasty；单钩/整组/辅助/Forge支持仍合并同一家族，0新增独立单位。"
  ],
