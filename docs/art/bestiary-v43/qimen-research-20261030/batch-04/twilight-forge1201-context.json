  "chain": [
    {
      "step": "注册与入口",
      "observation": "@Mod构造注册TFItems/TFEntities；block_and_chain注册ChainBlockItem，CHAIN_BLOCK factory注册ChainBlock。use读取实际hand栈，已有chainEntity UUID即PASS；server生成并存UUID，随后startUsingItem(hand)。",
      "evidence": [
        "TwilightForestMod.java77–114",
        "TFItems.java126",
        "TFEntities.java43,122–146",
        "ChainBlockItem.java52–104"
      ]
    },
    {
      "step": "栈与状态身份",
      "observation": "构造器this.stack=stack保存实际引用，不是copy；HAND与IS_FOIL为synched data，附加spawn写owner实体ID与hand。UUID只约束该栈门禁，不是玩家全局单投射物证明。getThrownEntity只检查该ServerLevel找到且类型正确，不比owner。",
      "evidence": [
        "ChainBlock.java44–98,314–356",
        "ChainBlockItem.java63–103"
      ]
    },
    {
      "step": "真正伤害成立",
      "observation": "服务端且目标非owner才进入；Living或其PartEntity父体提供伤害。玩家盾禁用先于hurt结果；只有damage>0且hurt返回true才播命中反馈、hitEntity=true、isReturning=true、tickCount+=60并扣栈1耐久。盾操作不能当作已成功伤害证据。",
      "evidence": [
        "ChainBlock.java121–152"
      ]
    },
    {
      "step": "方块与预算",
      "observation": "非正确采掘工具时进入反弹并返程；带破坏附魔且无挖掘疲劳可尝试AABB破坏。每块仍需tool、canEntityDestroy、BreakEvent未取消和harvest check。计数条件为>12，不是>=12；未把13次或附魔等级拆成独立案例。",
      "evidence": [
        "ChainBlock.java73–86,154–247",
        "ChainBlockItem.java121–142"
      ]
    },
    {
      "step": "返回和退出",
      "observation": "server owner为null则discard；距owner>16使返程；返程按tickCount*0.03 capped1将原bounce速度混合到朝owner眼高的2倍方向速度。距owner<2扣已破坏块最多3耐久后discard，但该分支没有立即return，仍继续本tick后续速度计算。remove只在owner当前useItem是本物品时stopUsingItem；UUID后续由inventoryTick查不到实体清理。",
      "evidence": [
        "ChainBlock.java249–327",
        "ChainBlockItem.java52–57"
      ]
    },
    {
      "step": "不冒充退出覆盖",
      "observation": "本类tick未检查owner.isAlive、是否仍持原栈或是否仍在使用；ChainBlockItem没有自定义releaseUsing回收。不能把松手、换手、死亡、跨维、卸载全算作已验证的统一退出。canChangeDimensions=false仅表明本实体拒跨维。",
      "evidence": [
        "ChainBlock.java101–104,249–327",
        "ChainBlockItem.java1–143"
      ]
    },
    {
      "step": "链端与真实绘制",
      "observation": "客户端tick更新5个Chain辅助对象，按owner.lookAngle加主副手±0.4rad偏移，沿锤头至手端的0.05/0.25/0.45/0.65/0.85插值放置。未读取mainArm、第一人称相机专用手端或当前ItemStack identity。renderer实际绘锤头+5链节，partialTicks插值各自位置与朝向，RGB/alpha为1、使用入参light；不是平均色近似。",
      "evidence": [
        "ChainBlock.java253–278",
        "BlockChainRenderer.java29–88",
        "Chain.java9–39"
      ]
    },
    {
      "step": "绑定到消费者",
      "observation": "客户端MOD总线RegisterRenderers将CHAIN_BLOCK绑定BlockChainRenderer；RegisterLayerDefinitions把CHAIN_BLOCK与CHAIN分别绑定SpikeBlockModel.create和ChainModel.create。两模型分别声明64x48和64x64。renderer使用textures/model/blockgoblin.png。未读该PNG，不能把源码链称作模型+贴图视觉参考。",
      "evidence": [
        "TFClientSetup.java116–118,176–178",
        "TFLayerDefinitions.java21–25,71,116",
        "SpikeBlockModel.java17–28,170–182",
        "ChainModel.java16–40",
        "TwilightForestMod.java62–65,348–350",
        "BlockChainRenderer.java25–54"
      ]
    },
    {
      "step": "手持模型状态",
      "observation": "ModelEvent.ModifyBakingResult调用addItemModelProperties，为block_and_chain注册thrown UUID predicate；真实item JSON在predicate=1时切到thrown模型，二者parent均handheld。UUID是否已正确复制到客户端及reload时序未实测。",
      "evidence": [
        "TFClientEvents.java91–108",
        "TFItems.java363–364",
        "models/item/block_and_chain.json1–14",
        "models/item/block_and_chain_thrown.json1–6"
      ]
    },
    {
      "step": "存档边界",
      "observation": "本类NBT只另存/读BlockAndChainStack，ItemStack.of产生读档栈；isReturning、blocksSmashed、canSmashBlocks、velXYZ、hitEntity、HAND和IS_FOIL未在本类自定义NBT逐项恢复。继承super的owner保存和外部生命周期未在此批全文阅读，不承诺读档等同继续原飞行，也不推断必然崩溃。",
      "evidence": [
        "ChainBlock.java44–53,314–341"
      ]
    }
  ],
