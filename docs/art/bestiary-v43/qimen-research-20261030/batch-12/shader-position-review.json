  "evidence": [
    {
      "id": "B01",
      "finding": "实际entitySolid shader supplier从GameRenderer.getRendertypeEntitySolidShader取值；加载的是rendertype_entity_solid配方，NEW_ENTITY顶点格式。",
      "sources": [
        {
          "source": "GameRenderer",
          "ranges": [
            [
              490,
              495
            ],
            [
              1319,
              1327
            ]
          ]
