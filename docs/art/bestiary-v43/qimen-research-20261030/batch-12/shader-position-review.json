              484,
              503
            ]
          ]
        },
        {
          "source": "RenderType",
          "ranges": [
            [
              34,
              48
            ]
          ]
        }
      ],
      "limit": "仅默认固定版本；资源包/优化模组替换仍未运行。",
      "credit_added": 0
    },
    {
      "id": "B02",
      "finding": "RenderType.end顺序是结束buffer→setup全部render state→BufferUploader.drawWithShader→clear states；ShaderState只设置当前Shader引用。真正ShaderInstance.apply在VertexBuffer.draw之前。",
      "sources": [
        {
          "source": "RenderType",
          "ranges": [
            [
              426,
              435
            ],
            [
              488,
              493
            ]
          ]
        },
        {
          "source": "RenderStateShard",
          "ranges": [
            [
              488,
              503
            ]
          ]
        },
        {
          "source": "BufferUploader",
          "ranges": [
            [
              25,
              42
            ]
          ]
        },
        {
          "source": "VertexBuffer",
          "ranges": [
            [
              123,
              185
            ]
          ]
        },
        {
          "source": "RenderSystem",
          "ranges": [
            [
              791,
              806
            ]
          ]
        }
      ],
      "limit": "不是只看RenderType名字就能断定最终GPU状态；无OpenGL执行。",
      "credit_added": 0
    },
    {
      "id": "B03",
      "finding": "solid.json的srcalpha/1-srcalpha会被parseBlendNode解析成非opaque BlendMode；ShaderInstance.apply再调用blend.apply。",
      "sources": [
        {
          "source": "solid_json",
          "ranges": [
            [
              1,
              34
            ]
          ]
        },
        {
          "source": "ShaderInstance",
          "ranges": [
            [
              250,
              306
            ],
            [
              333,
              341
            ]
          ]
        },
        {
          "source": "BlendMode",
          "ranges": [
            [
              21,
              63
            ],
            [
              121,
              148
            ]
          ]
        }
      ],
      "limit": "存在BlendMode.lastApplied缓存，所以不能据JSON单独断言一定启用混合。",
      "credit_added": 0
    },
    {
      "id": "B04",
      "finding": "NO_TRANSPARENCY setup显式disableBlend；BlendMode.apply只有lastApplied为空或opaque状态变化时才启/停blend，equal时直接跳过。RenderSystem/GlStateManager的blend开关并不同时更新BlendMode.lastApplied。",
      "sources": [
        {
          "source": "RenderStateShard",
          "ranges": [
            [
              28,
              31
            ]
          ]
        },
        {
          "source": "BlendMode",
          "ranges": [
            [
              11,
              63
            ]
          ]
        },
        {
          "source": "RenderSystem",
          "ranges": [
            [
              244,
              272
            ]
          ]
        },
        {
          "source": "GlStateManager",
          "ranges": [
            [
              94,
              124
            ]
          ]
        }
      ],
      "limit": "得到的是依前序state而定的两种条件路径；不能从孤立draw选定实际执行分支，也不宣称已复现引擎bug。",
      "credit_added": 0
    },
    {
      "id": "B05",
      "finding": "ShaderInstance.clear清program和纹理绑定，没有重置BlendMode.lastApplied。故本批继续保留透明dummy的实际可见性待验证，不能写成已修好或必现粉色。",
      "sources": [
        {
          "source": "ShaderInstance",
          "ranges": [
            [
              316,
              373
            ]
          ]
        },
        {
          "source": "BlendMode",
          "ranges": [
            [
              11,
              63
            ]
          ]
        }
      ],
      "limit": "后续/前序整帧draw及第三方改动未重放。",
      "credit_added": 0
    },
    {
      "id": "B06",
      "finding": "solid fsh没有cutout discard，fog保留输入alpha。若实际启用srcalpha混合，alpha0不贡献颜色；若blend实际关闭，则不能用alpha0保证颜色不写入。",
      "sources": [
        {
          "source": "solid_fsh",
          "ranges": [
            [
              1,
              26
            ]
          ]
        },
        {
          "source": "cutout_fsh",
          "ranges": [
