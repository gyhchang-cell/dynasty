  "observations": [
    {
      "finding": "当前rope/claw包有原始眼部origin和世界endpoint方向，没有used-hand字段；renderer手端为固定actor局部偏移。",
      "source": [
        "src/main/java/com/dynasty/cod3/EquipmentFeedback.java:165",
        "src/main/java/com/dynasty/cod3/Cod3VisualPacket.java:11",
        "src/main/java/com/dynasty/client/Cod3VfxRenderer.java:373"
      ],
      "implication": "后续第一/第三人称、左右主手、副手及远端观察需检查手端；不能由此静态认定玩家当前一定看到断链。"
    },
    {
      "finding": "绳端保持原始packet.origin+direction，actor可插值跟随；视觉端点不得替换服务器射线/伤害判定。",
      "source": [
        "src/main/java/com/dynasty/client/Cod3VfxRenderer.java:215"
      ],
      "implication": "未来表现适配应保留既有世界命中点语义。"
    },
    {
      "finding": "meteor/duck/crossbow画面有独立几何特效；它们并不证明实际手持模型已发生同样动作。",
      "source": [
        "src/main/java/com/dynasty/client/Cod3VfxRenderer.java:384"
      ],
      "implication": "特效回执、实际物品持姿、成功伤害要分别验收。"
    },
    {
      "finding": "repeat/siege模型继承原版crossbow并引用原版pull/charged模型。",
      "source": [
        "src/main/resources/assets/dynasty/models/item/repeating_crossbow.json",
        "src/main/resources/assets/dynasty/models/item/siege_crossbow.json"
      ],
      "implication": "只说明该JSON链；尚未排除整合包资源覆盖，也不意味着已有服务端弹药测试失效。"
    },
    {
      "finding": "rope/hammer/claw使用original_item和实际original_texture；OriginalItemGeometry经processFrames烘焙实际PNG并保留display transforms。",
      "source": [
        "src/main/java/com/dynasty/client/OriginalItemGeometry.java:45"
      ],
      "implication": "不能把粒子/外置网格当作已修改此实际物品模型的证据。"
    }
  ],
