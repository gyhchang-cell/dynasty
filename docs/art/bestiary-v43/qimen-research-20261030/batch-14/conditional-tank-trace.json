{
  "kind": "CONDITIONAL_SOURCE_WALKTHROUGH_NOT_RUNTIME",
  "preconditions": [
    "同一个已开始使用的主手Chemthrower栈",
    "multitank=true且无外部事件改时长/取消Stop",
    "切换消息在releaseUsing前处理",
    "示例consumption=10、elapsed=10，不代表默认配置"
  ],
  "before": {
    "Fluid": "A:1000",
    "Fluid1": "B:300",
    "Fluid2": "C:500"
  },
  "sequence": [
    "onUseTick按当前A检查100<=1000，预算通过，本段不扣油",
    "forward=false后活动键顺序(B:300,C:500,A:1000)",
    "releaseUsing重新读B，扣10*10=100并写回B:200"
  ],
  "after": {
    "Fluid": "B:200",
    "Fluid1": "C:500",
    "Fluid2": "A:1000"
  },
  "claim_limit": "仅展示来源已明确的分支组合；没有运行客户端、包、事件或实际tick。"
}
