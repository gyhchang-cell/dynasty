  "evidence": [
    {
      "id": "A01",
      "finding": "特殊SpellArrow弹药先检查mana capability；无mana返回原生Arrow。非玩家或主手不是ICasterTool时返回父ArrowItem工厂。先new出的未返回自定义箭不是已入世界的额外箭。",
      "sources": [
        {
          "source": "SpellArrow",
          "ranges": [
            [
              41,
              54
            ]
          ]
        },
        {
          "source": "ArrowItem",
          "ranges": [
            [
              13,
              17
            ]
          ]
        }
      ],
      "limits": "仅所读固定版本工厂，不代表所有其他射手/附魔模组。",
      "new_reference_credit": 0
    },
    {
      "id": "A02",
      "finding": "所读SpellCrossbow未重写getSpellCaster，使用ICasterTool默认new SpellCaster(stack)。其构造从NBT反序列化新的Spell；getSpell返回本次caster内存对象；modifySpell append没有调用writeItem。此路径不能宣称永久给武器追加增幅。",
      "sources": [
        {
          "source": "ICasterTool",
          "ranges": [
            [
              84,
              96
            ]
          ]
        },
        {
          "source": "SpellCaster",
          "ranges": [
            [
              23,
              37
            ],
            [
              164,
              205
            ]
          ]
