  "chain": [
    {
      "step": "owner身份",
      "observation": "Projectile优先返回未removed的cachedOwner，否则只在当前ServerLevel按UUID重查。没有health/isAlive/当前持握门禁，缓存分支也不比较level。ChainBlock普通构造与附加spawn约束Living owner，不扩大为任意外部改写的安全保证。",
      "evidence": [
        "Projectile.java38–85",
        "ChainBlock.java73–86,350–355"
      ]
    },
    {
      "step": "alive不是removed",
      "observation": "LivingEntity.isAlive要求health>0，getOwner只检查removed。基础die可被Forge事件取消，基础tickDeath>=20时服务端移除。ServerPlayer.die覆写没有直接remove；Player基类/重生/断线未补全，不能承诺玩家死亡20tick必清理链锤。",
      "evidence": [
        "LivingEntity.java543–550,1299–1332,1502–1504",
        "ServerPlayer.java571–626"
      ]
    },
    {
      "step": "真实命中与继续tick",
      "observation": "ThrowableProjectile由轨迹结果经Forge impact取消检查进入onHit；Projectile向ENTITY/BLOCK覆写分派。随后仍处理阻力、重力和位置，没有通用命中即discard。ChainBlock先super.tick后自身owner/返程；未全文读ProjectileUtil交点筛选。",
      "evidence": [
        "Projectile.java88–177",
        "ThrowableProjectile.java41–90",
        "ChainBlock.java249–312"
      ]
    },
    {
      "step": "remove不等于卸载",
      "observation": "discard/kill经虚调用remove；ChainBlock.remove先super，再仅按owner当前useItem类型stopUsingItem，不比原栈身份。区块processChunkUnload与客户端removeEntity直接setRemoved，不会仅因该调用进入ChainBlock.remove。tracking callback发离场事件；默认onRemovedFromWorld只清added标志，未穷尽外部监听。",
      "evidence": [
        "Entity.java326–356,3348–3359,3435–3438",
        "PersistentEntitySectionManager.java233–248,428–449",
        "ClientLevel.java342–347",
        "ServerLevel.java1529–1555",
        "ChainBlock.java321–327"
      ]
    },
    {
      "step": "owner查不到",
      "observation": "ServerLevel.getEntity(UUID)读当前visibleEntityStorage；pending加载和追踪状态影响可见性。ChainBlock只要getOwner为null即discard，不区分尚未入索引、已卸载或不存在。缓存未removed时不查索引。真实加载先后及切维未实测。",
      "evidence": [
        "Projectile.java47–56",
        "PersistentEntitySectionManager.java134–142,256–271",
        "ServerLevel.java1115–1118",
        "ChainBlock.java280–310"
      ]
    },
    {
      "step": "存档恢复范围",
      "observation": "Entity保存并恢复Pos/Motion/Rotation；Projectile追加Owner/LeftOwner/HasBeenShot，读Owner清cached。ChainBlock追加BlockAndChainStack并用ItemStack.of重建。不能说完全没有速度持久化；但自身bounce备份velX/Y/Z、isReturning、blocksSmashed、hitEntity、canSmashBlocks和HAND/FOIL未在其NBT覆写保存，不证明原持握栈引用或完整飞行快照恢复。",
      "evidence": [
        "Entity.java1594–1763",
        "Projectile.java62–85",
        "ChainBlock.java44–86,330–341"
      ]
    },
    {
      "step": "辅助链与multipart区分",
      "observation": "已全文读BlockChainGoblin和TFPart。邻接怪物显式覆写isMultipartEntity/getParts；ChainBlock自己的partsArray只有构造赋值，类中无同样覆写或公开消费者，客户端逐链tick定位并由B4已读renderer绘制。Forge跟踪要求parent实际isMultipartEntity/getParts；私有数组和isPickable不能证明服务器碰撞注册。默认IForgeEntity/PartEntity及外部注入未读，不断言全局绝无multipart。",
      "evidence": [
        "BlockChainGoblin.java68–73,326–343",
        "TFPart.java17–150",
        "ChainBlock.java55–84,249–277",
        "ServerLevel.java1520–1524",
        "ClientLevel.java960–978"
      ]
    }
  ],
  "dedup": "既有暮色链锤补读；版本、引擎类、邻接怪物、五链不拆案例，不增加生物视觉参考。",
  "pending_reads": [
    "准确Player.tickDeath、PlayerList重生/离线、跨维与外部监听顺序。",
    "IForgeEntity/PartEntity默认multipart、ProjectileUtil筛选、EntityStorage磁盘编解码。",
    "原持握栈读档重绑定、左右惯用手与同步晚到、实机。",
    "本研究没有生物模型+PNG视觉参考信用。"
  ],
