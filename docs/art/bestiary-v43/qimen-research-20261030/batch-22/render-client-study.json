  "evidence": [
    {
      "id": "R01",
      "title": "实体爪体与手持卷扬器分开",
      "fact": "实体 renderer 使用 32×32 钢爪 PNG，2对反面+4旋转爪面共8quads；手持另走物品 JSON。item registry path 拼入 Klaxon 目录，不保留外部命名空间。",
      "limit": "不是 Gecko 生物或通用跨模组自动纹理机制；无游戏画面。",
      "sources": [
        "S1",
        "S8",
        "S3"
      ],
      "credit_added": 0
    },
    {
      "id": "R02",
      "title": "实际替换上下文",
      "fact": "ALT_HAND_MODEL 对 GUI/FIXED/GROUND 之外上下文启用，alternate 模型再解析自己的 overrides；左手可选 mirrored。",
      "limit": "不能说仅第一人称；未模拟 Minecraft 烘焙与手臂矩阵。",
      "sources": [
        "S10",
        "S13",
        "S11"
      ],
      "credit_added": 0
    },
    {
      "id": "R03",
      "title": "镜像有具体边界",
      "fact": "ModelUtils 围绕 X=8 反转 from/to、换东西面UV、反转Y/Z角；rotation origin 和 display transforms 保持。",
      "limit": "非中心 origin 的一般情况不可直接保证；本轮不修改作者资源、不宣称运行出错。",
      "sources": [
        "S12",
        "S14",
        "S15"
      ],
      "credit_added": 0
    },
    {
      "id": "R04",
      "title": "状态谓词按玩家连接",
      "fact": "cable_length 为已有连接 cable/max；charged 看 charged projectiles；retracting 看玩家连接状态。未连接缺省0。",
      "limit": "未绑定原始发射 stack，不能称逐 stack 独立状态。",
      "sources": [
        "S2",
        "S9",
        "S4"
      ],
      "credit_added": 0
    },
    {
      "id": "R05",
