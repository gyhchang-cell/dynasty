  "exit_matrix": [
    {
      "trigger": "松手或第二次经典模式使用",
      "upstream": "clear hasHook；非经典模式加冷却；后续server tick若仍false则discard+return",
      "port": "release/finish clear hasHook；后续tick kill但无return",
