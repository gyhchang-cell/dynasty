  "source_read_scope": "BakedModelFactory/GeoQuad/GeoCube/Cube/Bone/UVUnion/UVFaces/FaceUV full; GeoBone constructor and visibility; GeoRenderer recursive/cubes/child/cube; GeoArmorRenderer preRender/actuallyRender/slot/base-transform; RenderUtils matrix and match methods; JsonUtil numeric defaults",
  "rules": [
    "cube mirror only; bone mirror stored but not inherited by Builtin.constructCube",
    "inflate cube override else bone; divide by16; enlarge vertices not UV",
    "origin X negates origin+width; pivot X and rotation X/Y negated; angles radians",
    "boxUV floor original uninflated size; down UV size negative Z; per-face missing faces omitted",
    "mirror swaps east/west vertex routes; per-face also up/down; GeoQuad not-mirror swaps U; mirror flips normal X; no vanilla winding reversal",
    "matrix bone translate/pivot/Z/Y/X/scale/unpivot; cube pivot/Z/Y/X/unpivot; hierarchy retained",
    "setHidden hides children too; Ars recursive equalsIgnoreCase removes slim subtrees",
    "non-GeoAnimatable entity slot gating; GeoAnimatable branch requires caller-specific validation"
  ],
  "engine_execution": false
