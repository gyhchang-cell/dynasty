{"client_side":"required","server_side":"unsupported","game_versions":["1.20.1","1.20.2","1.20.3","1.20.4","1.20.5","1.20.6","1.21","1.21.1","1.21.2","1.21.3","1.21.4","1.21.5","1.21.6","1.21.7","1.21.8","1.21.9","1.21.10","1.21.11","26.1-snapshot-2","26.1","26.1.1","26.1.2","26.2","26.3"],"environment":["client_only"],"id":"wF189hn9","slug":"ukus-armor-hud","project_type":"mod","team":"pOyDl5Qm","organization":null,"title":"uku's Armor HUD","description":"Minimalist vanilla-like widget to display your armor items and their durability. Forked by uku.","body":"# uku's Armor HUD\n\nMinecraft mod that adds a HUD widget that shows your current armor items.\n\nThis mod adds a minimalist vanilla-like widget that shows your armor items and a warning if durability is low enough. While other mods expect the player to look at numbers all over the screen, this mod allows to see your armor items in a vanilla-style minimalist widget without extra text or numbers. Position and other parameters of the widget can be adjusted in the configuration file.\n\nCredits:\n- [Original mod by BerdinskiyBear](https://www.curseforge.com/minecraft/mc-mods/berdinskiybears-armor-hud), forked by uku.\n- Armor breaking sound from [Giselbaer's Durability Viewer](https://modrinth.com/mod/durabilityviewer)","body_url":null,"published":"2023-07-20T08:57:56.480172Z","updated":"2026-10-03T21:05:37.442765Z","approved":"2023-07-22T18:37:26.922576Z","queued":"2023-07-20T09:09:55.363967Z","status":"approved","requested_status":"unlisted","moderator_message":null,"license":{"id":"MIT","name":"MIT License","url":null},"downloads":10014803,"followers":2241,"categories":["equipment","utility"],"additional_categories":[],"loaders":["fabric","neoforge","quilt"],"versions":["5ZvuA0R8","IJALWJq8","CJ7EWB1B","F1irP06N","DDwWClw8","inle1PJL","TP7OChl2","KvfhcyfG","wIqWnz0K","W8Ei6f7E","cu46k55S","heXscFzR","T4dxks62","h3thCvUO","EpM5zTvZ","kuUj4wPZ","DYA8JV1n","Gd7KKiXi","kMa8HQ8N","WziKBsqj","xQM16D7I","ZDZWmIsH","Dj