{
  "date": "2026-11-26",
  "main_commit": "0815fb0d1ed038e730807924834449e6d5f97c83",
  "scope": "COD4-3 三把重武器固定落点，第13批锻斧实握、延迟命中及碎块路径",
  "status": "PINNED_WROUGHT_AXE_INPUT_DELAYED_STACK_AND_QUAKE_REVIEWED_SUPPORT_ONLY",
  "findings": [
    {
      "stage": "实握与动作准入",
      "observation": "ItemWroughtAxe.use 只在主手、满充能、个人动作间隔可用时选择特殊动作。按下潜行且当时 onGround 决定竖向砸击。服务端 AbilityHandler 另做技能 canUse 并激活，但外层不读取返回值，仍能设姿态、30刻锁、开始使用及尝试扣耐久。这些副作用不能单独证明技能生成或碰地。"
    },
    {
      "stage": "武器与玩家归属",
      "observation": "竖向技能在开始时创建效果实体并用创建当刻的主手栈写 AXE_STACK，代码未显式复制该栈。EntityMagicEffect 按 UUID 解析施术者。延迟直接命中临时把 AXE_STACK 和相应属性换入玩家主手，独立创建 playerAttack(player)，再调用 hurt。伤害布尔决定后续结算，外层几何命中声不依赖该布尔；没有 finally，不能移植临时换手。"
    },
    {
      "stage": "碰地、落点、材质",
      "observation": "竖向直接伤害定在效果实体 tick 14。地震保存该刻朝向和垂直 AABB，但效果实体跟随玩家，扩散中心每刻重读 X/Z。材质按固定 floor(minY-0.5) 的格状态、遮挡和实心条件挑选；未重查攻击者向下实际碰撞、原始支撑格或半砖高度。碎块以客户端已注册的实体模型渲染从数据字段读取的状态，非普通落地粒子包。"
    },
    {
      "stage": "次数边界",
      "observation": "tick 16..25 的各扇形样点各自尝试碎块实体与地震伤害，样点循环没有全攻击级实体或方块去重。雷震分支与前置直接 hurt 无共享成功回执，只有对地震目标的击退检查这一轮 hurt。tick 25 在末尾 discard。一次技能开始、范围成功、单一稳定落点和每玩家收到一次仍是不同命题。"
    }
  ],
  "limits": [
    "源为固定 Mowzie NeoForge 版本样本。仅调用处无显式 copy，不据此外推其他版本数据同步底层的引用保存语义。",
    "块实体/粒子创建和真实客户端传输未验。未把角色移动、服务器校验、原生碰撞或视觉作为 Dynasty 通过。"
  ],
  "dedup": "已接受 0c6a027d05c8a3f1aeec 覆盖原延迟 hurt 与临时换手。此前 WroughtAxeSlamAbility 和玩家 geomancy GroundSlam 作为支持，本次只补实际 ItemStack 入口到地震支撑和显示，整体保留既有族，正式新增0。",
