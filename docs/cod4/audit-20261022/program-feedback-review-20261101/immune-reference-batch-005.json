  "cases": [
    {
      "id": "tconstruct-self-destruct-key-release-versus-effect-countdown-support",
      "status": "AUXILIARY_ZERO_CREDIT",
      "research_credit": 0,
      "full_chain_observation": "實際SelfDestructive與self_destructing效果註冊；client START tick讀原生頭盔按鍵上升/下降沿，呼叫本地InteractionHandler，再用已註冊PLAY_TO_SERVER的TinkerControlPacket enum送server；handler取context.sender而不接受目標UUID，再讀其目前armor/tag/詞條。SelfDestructive只在player.isShiftKeyDown時嘗試30tick效果並播primed聲。效果最後duration==1才server爆炸及hurt99999；stopInteract或onUnequip移除該effect。",
      "observations": [
        "startArmorInteract在任何ARMOR標籤裝備均回true，不等於某詞條成功；首次回true詞條只記slot→modifierId/startTick。SelfDestructive沒有以addEffect實際結果決定回true或聲音。",
        "服務端以玩家實際shift判斷，不只信任packet所攜SHIFT enum；但start路徑沒有broken/cooldown/重複啟動或持續按鍵server watchdog。",
        "stopArmorInteract只在非旁觀者且目前該槽仍ARMOR時取出map entry；通知目前裝備全部詞條，非只activeModifier；預設新版hook轉呼叫舊版，因此SelfDestructive的舊stop覆寫實際會被呼叫。",
        "onUnequip無同物品/同詞條豁免且無changedSlot限定，直接移除效果；與StrongBones保留同類裝備的政策不同，但這個分支不另計。",
        "NoMilkEffect返回空curative list；show=true由TinkerEffect原生client extension提供inventory/gui可見旗標。這不是自訂成功回執，並未驗證圖示資產或實機呈現。",
        "capability僅內存，invalidate保留原Holder；client wasHelmetInteracting是static欄位，所讀本地來源無logout清零。不能宣稱切世界、重連或掉線皆安全解除。",
        "效果倒數有界不等於安全取消：若stop未生效，倒數的終點是爆炸。爆炸和自傷不是整體交易，未依hurt回傳證明自殺成功。"
      ],
      "dedup": [
        {
          "against": "simplyswords-native-timed-parry-stack-identity-and-charge-receipt",
          "decision": "support only",
          "reason": "使用態/停止清理已有完整案例；本例缺同stack/world驗證而依有限效果續行，作控制解除邊界對照，未證成另一免疫拒控單位。"
        },
        {
          "against": "simplyswords-native-charge-absorb-counter-mode-qualified-refusal",
          "decision": "support only",
          "reason": "不要將蓄力輸入和結束效果不同即算新控制機制；此例不主張吸傷/拒控信用。"
        }
      ],
      "limitations": [
        "Mantle IThreadsafePacket/NetworkWrapper本地來源缺失，已核對本模組註冊方向及handleThreadsafe入口；不聲稱底層排程、封包順序、斷線清理或TCP通過。",
        "未運行遊戲或Java；沒有跨維度/旁觀者切換復現。",
        "共享裝備Watcher、enum變體、curative空列表、忽略bool均不另計；爆炸傷害類型標籤不擴展成新的免傷研究。"
      ],
