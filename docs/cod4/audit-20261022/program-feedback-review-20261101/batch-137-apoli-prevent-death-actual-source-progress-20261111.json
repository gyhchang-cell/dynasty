      "raw_range_sha256": "b09f3b7d95b4153800910a0b177a606a95581513587dae50c59bff8538f9756c",
      "bytes": 421,
      "raw_excerpt_utf8": "    @ModifyExpressionValue(method = \"damage\", at = @At(value = \"INVOKE\", target = \"Lnet/minecraft/entity/LivingEntity;isDead()Z\", ordinal = 1))\n    private boolean apoli$preventDeath(boolean original, DamageSource source, float amount) {\n\n        if (original && PreventDeathPower.doesPrevent(this, source, amount)) {\n            this.setHealth(1.0F);\n            return false;\n        }\n\n        return original;\n\n    }\n"
    }
