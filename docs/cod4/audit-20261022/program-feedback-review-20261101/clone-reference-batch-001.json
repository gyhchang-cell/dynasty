    {
      "id": "coldsweat-player-location-scoped-particle-preference-clone-and-join-replacement",
      "status": "PROPOSED_PENDING_COORDINATOR_SCOPE_AND_SEMANTIC_REVIEW",
      "credit": 0,
      "refs": [
        "R1",
