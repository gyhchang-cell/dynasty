          "source_sha256": "9ef84aad510c4d7e4a3d11121956045e9a92f1c58dce5166c01d7ea19e629b59",
          "line": 83,
          "end_line": 85,
          "excerpt": "  public static boolean validSlot(IToolStackView tool, EquipmentSlot slot, @Nullable TagKey<Item> heldTag) {\n    return slot.isArmor() || heldTag != null && tool.hasTag(heldTag);\n  }",
          "snippet_sha256": "e155f75d519c5dc54f9d5d385d8400ca8f6be3a930509d495b66371178bba15f",
