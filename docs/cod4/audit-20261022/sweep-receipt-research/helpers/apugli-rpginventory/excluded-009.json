          "source_sha256": "bd0739630fa2b538574b618a725d4a2f40a2771ebd5963ab0988e602918456a6",
          "line": 100,
          "end_line": 108,
          "excerpt": "    private void addSlot(EquipmentSlot slotType, int level) {\n      int index = slotType.getFilterFlag();\n      totalLevel += level - levels[index];\n      levels[index] = level;\n      // prefer armor in charge as hand only runs when blocking, prefer mainhand over offhand\n      if (inCharge == null || (inCharge.getType() == Type.HAND && slotType != EquipmentSlot.OFFHAND)) {\n        inCharge = slotType;\n      }\n    }",
          "snippet_sha256": "9f184d3df9e17757a3705bee51df5c1fd0f1c32f4077c715f9974f32576d8918",
          "role": "Overwrite per-slot contribution by delta; elect consumer",
          "url": "https://github.com/SlimeKnights/TinkersConstruct/blob/f4e77d43f39ba1047bf93ae816b7e1beaab514c2/src/main/java/slimeknights/tconstruct/library/modifiers/modules/technical/SlotInChargeModule.java#L100-L108",
          "evidence_kind": "complete_method"
        },
        {
          "repo": "SlimeKnights/TinkersConstruct",
          "revision": "f4e77d43f39ba1047bf93ae816b7e1beaab514c2",
          "path": "src/main/java/slimeknights/tconstruct/library/modifiers/modules/technical/SlotInChargeModule.java",
          "method": "removeSlot",
          "source_metadata": "tools/cod4/sweep-receipt-research/helpers/apugli-rpginventory/sources/SlimeKnights__TinkersConstruct-009/source.json",
          "source_root": "tools/cod4/sweep-receipt-research/helpers/apugli-rpginventory/sources/SlimeKnights__TinkersConstruct-009",
          "source_local": "tools/cod4/sweep-receipt-research/helpers/apugli-rpginventory/sources/SlimeKnights__TinkersConstruct-009/src/main/java/slimeknights/tconstruct/library/modifiers/modules/technical/SlotInChargeModule.java",
          "source_sha256": "bd0739630fa2b538574b618a725d4a2f40a2771ebd5963ab0988e602918456a6",
          "line": 111,
          "end_line": 130,
          "excerpt": "    private void removeSlot(EquipmentSlot slotType) {\n      int index = slotType.getFilterFlag();\n      totalLevel -= levels[index];\n      levels[index] = 0;\n      // prioritize armor slots\n      for (EquipmentSlot armorSlot : ModifiableArmorMaterial.ARMOR_SLOTS) {\n        if (levels[armorSlot.getFilterFlag()] > 0) {\n          inCharge = armorSlot;\n          return;\n        }\n      }\n      // if none, find a hand slot\n      for (EquipmentSlot hand : InteractionHandler.HAND_SLOTS) {\n        if (levels[hand.getFilterFlag()] > 0) {\n          inCharge = hand;\n          return;\n        }\n      }\n      inCharge = null;\n    }",
          "snippet_sha256": "995b52bfc0574b96df0d255f3d915e16c446b2e39c65894c220f10d948a920e3",
          "role": "Subtract old contribution then elect remaining armor/hand",
          "url": "https://github.com/SlimeKnights/TinkersConstruct/blob/f4e77d43f39ba1047bf93ae816b7e1beaab514c2/src/main/java/slimeknights/tconstruct/library/modifiers/modules/technical/SlotInChargeModule.java#L111-L130",
          "evidence_kind": "complete_method"
        },
