<project version="4">
  <!--
    项目 SDK = temurin-17（在 IDEA 的 JDK 表里刚补好的那个，HomePath 就是
    /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home）。
    languageLevel 16 不用管，真正的编译版本由 Gradle 的 Java 17 toolchain 决定。
  -->
  <component name="ProjectRootManager" version="2" languageLevel="JDK_17" default="true"
             project-jdk-name="temurin-17" project-jdk-type="JavaSDK">
    <output url="file://$PROJECT_DIR$/out" />
  </component>
</project>
